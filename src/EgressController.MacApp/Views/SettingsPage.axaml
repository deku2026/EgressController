<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EgressController.MacApp.ViewModels" x:Class="EgressController.MacApp.Views.SettingsPage" x:DataType="vm:MacMainViewModel">
  <ScrollViewer><StackPanel Spacing="16">
    <Border Classes="card" Padding="22"><StackPanel Spacing="18"><StackPanel Spacing="6"><TextBlock Text="Surge API" Classes="card-title"/><TextBlock Text="用于读取后端状态与测试节点；本机地址建议使用 127.0.0.1。" Classes="muted" TextWrapping="Wrap"/></StackPanel><Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="16" ColumnSpacing="16"><TextBlock Text="API 地址" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding SurgeEndpoint}"/><TextBlock Grid.Row="1" Text="API 密钥" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SurgeKey}" PasswordChar="●" PlaceholderText="留空保留 Keychain 中的密钥"/><TextBlock Grid.Row="2" Text="Surge CLI" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SurgeCliPath}"/></Grid><StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"><Button Content="检测连接" Command="{Binding CheckSurgeCommand}" IsEnabled="{Binding !Busy}"/><Button Content="保存设置" Classes="primary" Command="{Binding SaveSettingsCommand}" IsEnabled="{Binding !Busy}"/></StackPanel></StackPanel></Border>
    <Border Classes="card" Padding="22"><StackPanel Spacing="12"><TextBlock Text="后台检测" Classes="card-title"/><TextBlock Text="订阅页开启自动检测后，Mac Agent 可按 15 分钟周期运行。关闭窗口不会启用或停止 Surge。" TextWrapping="Wrap" Classes="muted"/><TextBlock Text="Agent 安装与卸载由独立打包脚本管理，当前不会更改你的登录项。" TextWrapping="Wrap" Classes="muted" FontSize="12"/></StackPanel></Border>
    <Border Classes="card" Padding="22"><StackPanel Spacing="10"><TextBlock Text="本机数据" Classes="card-title"/><TextBlock Text="分流选择、有效配置与订阅文件在私有目录保存。账户、Surge API 密钥与服务器凭据存入系统 Keychain。" TextWrapping="Wrap" Classes="muted"/><Button Content="打开日志目录" Command="{Binding OpenLogsCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
