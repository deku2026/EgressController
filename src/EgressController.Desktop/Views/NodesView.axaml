<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EgressController.Desktop.ViewModels" xmlns:ui="using:EgressController.Desktop.Presentation.Controls" xmlns:views="using:EgressController.Desktop.Views" x:Class="EgressController.Desktop.Views.NodesView" x:DataType="vm:ShellViewModel">
 <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="17">
  <Border Classes="card" Padding="18" MaxHeight="240"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="13"><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8"><ui:Glyph Kind="refresh" Width="15" Height="15" Foreground="#8195B4"/><TextBlock Text="{Binding SubscriptionName}" FontSize="13" FontWeight="SemiBold"/></StackPanel><TextBlock Grid.Column="1" Text="仅导入节点与分组" FontSize="10" Foreground="#95A1B3"/></Grid><Grid ColumnDefinitions="*,Auto" ColumnSpacing="9"><TextBox Name="SubscriptionUrlBox" Text="{Binding SubscriptionUrl,Mode=TwoWay}" PlaceholderText="Clash YAML 订阅 URL" FontSize="11" AutomationProperties.Name="订阅URL"/><Button Grid.Column="1" Name="ImportSubscriptionButton" Content="更新订阅" Command="{Binding ImportSubscriptionCommand}"/></Grid><TextBlock Text="{Binding SubscriptionDescription}" FontSize="9.5" Foreground="#9DA7B8" TextWrapping="Wrap"/><views:LocalSubscriptionView/></StackPanel></ScrollViewer></Border>
  <Border Grid.Row="1" Background="#EDF3FE" BorderBrush="#DFE8F9" BorderThickness="1" CornerRadius="10" Padding="18,15"><Grid ColumnDefinitions="35,*,230" ColumnSpacing="12"><Border Width="34" Height="34" Background="#DFE9FB" CornerRadius="9"><ui:Glyph Kind="globe" Width="20" Height="20" Foreground="#668ACA"/></Border><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="全局默认代理" FontSize="13" FontWeight="SemiBold" Foreground="#426AA9"/><TextBlock Text="全球其他流量的最终出口 · 节点连接严格经非家宽" FontSize="10" Foreground="#8198BA" TextWrapping="Wrap"/></StackPanel><ComboBox Name="GlobalTargetBox" Grid.Column="2" ItemsSource="{Binding GlobalChoices}" SelectedItem="{Binding SelectedGlobalTarget,Mode=TwoWay}" VerticalAlignment="Center" PlaceholderText="必须选择代理"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:Choice"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid></Border>
  <Grid Grid.Row="2" ColumnDefinitions="*,280,Auto" ColumnSpacing="10"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="节点与成员" Classes="section"/><TextBlock Text="{Binding NodeCountLabel}" Classes="caption" FontSize="10"/></StackPanel><TextBox Grid.Column="1" Name="NodeSearch" Text="{Binding NodeQuery,Mode=TwoWay}" PlaceholderText="搜索节点、协议、地址或分组…" AutomationProperties.Name="搜索节点"/><Button Grid.Column="2" Content="{Binding ProbeLabel}" Command="{Binding RunProbesCommand}"/></Grid>
  <Border Grid.Row="3" Classes="card" Padding="0"><Grid RowDefinitions="Auto,Auto,*"><Grid Margin="17,15" ColumnDefinitions="190,*,170" ColumnSpacing="14"><ComboBox ItemsSource="{Binding GroupChoices}" SelectedItem="{Binding SelectedGroup,Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:Choice"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Grid.Column="1" Text="{Binding GroupSummary}" FontSize="10" Foreground="#8D9BB1" TextWrapping="Wrap"/><ComboBox Grid.Column="2" ItemsSource="{Binding GroupStrategies}" SelectedItem="{Binding SelectedStrategy,Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:Choice"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
   <StackPanel Grid.Row="1" IsVisible="{Binding IsManualGroup}" Orientation="Horizontal" Spacing="12" Margin="18,0,18,13"><TextBlock Text="当前选中节点" FontSize="11" Foreground="#8694AA"/><ComboBox ItemsSource="{Binding GroupMemberChoices}" SelectedItem="{Binding SelectedGroupMember,Mode=TwoWay}" Width="250" PlaceholderText="请明确选择一个成员"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:Choice"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
   <Grid Grid.Row="2" RowDefinitions="Auto,*"><Border Classes="tableheader"><Grid ColumnDefinitions="28,38,*,72,86" ColumnSpacing="11"><TextBlock Text="成员" FontSize="9" Foreground="#8F9AAF"/><TextBlock Grid.Column="2" Text="节点" FontSize="10" Foreground="#8F9AAF"/><TextBlock Grid.Column="3" Text="{Binding LatencyHeader}" FontSize="9" Foreground="#8F9AAF"/><TextBlock Grid.Column="4" Text="协议状态" FontSize="9" Foreground="#8F9AAF"/></Grid></Border><ListBox Grid.Row="1" ItemsSource="{Binding VisibleNodes}" ItemContainerTheme="{StaticResource QuietRow}"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:NodeRow"><Grid ColumnDefinitions="28,38,*,72,86" ColumnSpacing="11" Margin="12,16"><CheckBox IsChecked="{Binding IsMember,Mode=TwoWay}" IsEnabled="{Binding IsSupported}" AutomationProperties.Name="{Binding Name}"/><Border Grid.Column="1" Background="#F2F5FA" CornerRadius="8" Width="34" Height="34"><TextBlock Text="{Binding Initial}" FontSize="11" Foreground="#7F94B6" FontWeight="SemiBold" HorizontalAlignment="Center"/></Border><StackPanel Grid.Column="2" Spacing="5"><TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="12"/><TextBlock Text="{Binding Subtitle}" FontSize="9.5" Foreground="#8D9CB1" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Subtitle}"/></StackPanel><TextBlock Grid.Column="3" Text="{Binding Latency}" FontSize="12" Foreground="#658CAA"/><TextBlock Grid.Column="4" Text="{Binding Status}" FontSize="10" Foreground="#8397AE"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Grid.Row="1" IsVisible="{Binding NoNodesMatch}" Text="没有匹配的节点，试试名称、协议或分组。" Classes="caption" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
  </Grid></Border>
 </Grid>
</UserControl>
