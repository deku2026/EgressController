<local:PageView xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:EgressController.App.Views" xmlns:vm="using:EgressController.App.ViewModels" xmlns:ui="using:EgressController.Presentation" x:Class="EgressController.App.Views.OverviewPage" x:DataType="vm:MainViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="18">
      <Grid ColumnDefinitions="1.4*,*,*" ColumnSpacing="16">
        <Border Classes="card" MinHeight="230">
          <Grid RowDefinitions="Auto,*,Auto">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="最近检测延迟" Classes="eyebrow" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Content="检测联网" Command="{Binding Network.CheckCommand}" Padding="10,5" MinHeight="28"/>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <TextBlock Text="{Binding Dashboard.DirectLatency}" FontSize="45" FontWeight="SemiBold"/>
              <TextBlock Text="ms" VerticalAlignment="Bottom" Margin="0,0,0,10" Foreground="#667184"/>
            </StackPanel>
            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="20">
              <StackPanel Spacing="5">
                <TextBlock Text="ESIM-家宽" Classes="muted"/>
                <TextBlock Text="{Binding Dashboard.DirectAdapter}" FontWeight="Medium"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="Proxy-代理" Classes="muted"/>
                <TextBlock Text="{Binding Dashboard.ProxyLatency, StringFormat='{}{0} ms'}" FontWeight="Medium"/>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
        <Border Grid.Column="1" Classes="card">
          <Grid RowDefinitions="Auto,Auto,*,Auto">
            <TextBlock Text="上传" Classes="eyebrow"/>
            <TextBlock Grid.Row="1" Text="{Binding Dashboard.UploadRate}" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,12"/>
            <ui:TrendChart Grid.Row="2" Samples="{Binding Dashboard.UploadSamples}" Maximum="{Binding Dashboard.ScaleMaximum}" Stroke="#6371D6" MinHeight="110"/>
            <TextBlock Grid.Row="3" Text="{Binding Dashboard.SampleTime}" Classes="muted" Margin="0,10,0,0"/>
          </Grid>
        </Border>
        <Border Grid.Column="2" Classes="card">
          <Grid RowDefinitions="Auto,Auto,*,Auto">
            <TextBlock Text="下载" Classes="eyebrow"/>
            <TextBlock Grid.Row="1" Text="{Binding Dashboard.DownloadRate}" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,12"/>
            <ui:TrendChart Grid.Row="2" Samples="{Binding Dashboard.DownloadSamples}" Maximum="{Binding Dashboard.ScaleMaximum}" Stroke="#55A8CF" MinHeight="110"/>
            <TextBlock Grid.Row="3" Text="{Binding Dashboard.SampleTime}" Classes="muted" Margin="0,10,0,0"/>
          </Grid>
        </Border>
      </Grid>
      <Grid ColumnDefinitions="*,1.05*" ColumnSpacing="16">
        <StackPanel Spacing="16">
          <Border Classes="card">
            <StackPanel Spacing="18">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="活动连接" Classes="eyebrow"/>
                <Border Grid.Column="1" Classes="badge" Classes.healthy="{Binding Dashboard.ObservationFresh}" Padding="8,4">
                  <TextBlock Text="{Binding Dashboard.FreshnessLabel}" Foreground="#667184" FontSize="11"/>
                </Border>
              </Grid>
              <TextBlock Text="{Binding Dashboard.ActiveCount}" Classes="metric"/>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="15">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Dashboard.ProtectedCount}" FontSize="23" FontWeight="SemiBold"/>
                  <TextBlock Text="受保护应用" Classes="muted"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="{Binding Dashboard.ExecutableCount}" FontSize="23" FontWeight="SemiBold"/>
                  <TextBlock Text="固定 EXE 路径" Classes="muted"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                  <TextBlock Text="{Binding Dashboard.PortCount}" FontSize="23" FontWeight="SemiBold"/>
                  <TextBlock Text="代理端口" Classes="muted"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Text="当前会话流量" Classes="eyebrow"/>
              <TextBlock Text="{Binding Dashboard.TotalTraffic}" Classes="metric"/>
              <Grid ColumnDefinitions="*,*">
                <StackPanel Spacing="4">
                  <TextBlock Text="已上传" Classes="muted"/>
                  <TextBlock Text="{Binding Dashboard.UploadTotal}" FontSize="18" FontWeight="Medium"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="已下载" Classes="muted"/>
                  <TextBlock Text="{Binding Dashboard.DownloadTotal}" FontSize="18" FontWeight="Medium"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="20">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="应用流量" Classes="section-title"/>
              <TextBlock Grid.Column="1" Text="活动连接流量占比" Classes="muted" VerticalAlignment="Center"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding Dashboard.Applications}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ApplicationTrafficRow">
                  <Grid ColumnDefinitions="34,*" ColumnSpacing="12" Margin="0,0,0,21">
                    <Border Width="32" Height="32" CornerRadius="9" Background="#E9EDF8">
                      <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#5062CE" FontWeight="SemiBold"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="8">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                          <TextBlock Text="{Binding Amount}" Foreground="#667184"/>
                          <TextBlock Text="{Binding ShareLabel}" Foreground="#667184" MinWidth="42" TextAlignment="Right"/>
                        </StackPanel>
                      </Grid>
                      <ProgressBar Value="{Binding Share}" Maximum="100" Height="4" Foreground="#7C8BD8" Background="#EDF0F5"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Spacing="9" Margin="0,50" IsVisible="{Binding Dashboard.IsEmpty}">
              <TextBlock Text="还没有活动连接" FontSize="17" FontWeight="Medium" HorizontalAlignment="Center"/>
              <TextBlock Text="打开应用后，这里会显示实际流量。" Classes="muted" HorizontalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
      <Border Background="#EAF2EE" Padding="17,13" CornerRadius="10" IsVisible="{Binding Dashboard.Ready}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding Dashboard.StatusTitle}" FontWeight="Medium" Foreground="#285E48"/>
            <TextBlock Text="{Binding Dashboard.StatusDetail}" Foreground="#527362" FontSize="12"/>
          </StackPanel>
          <Button Grid.Column="1" Content="运行事件" Click="OnShowDiagnostics" VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</local:PageView>
