<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><PlatformTarget>AnyCPU</PlatformTarget>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup>
    <EgressXrayArchive Condition="'$(EgressXrayArchive)' == ''">$(MSBuildProjectDirectory)/../../artifacts/core/Xray-macos-arm64-v8a.zip</EgressXrayArchive>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(EgressXrayArchive)')">
    <Content Include="$(EgressXrayArchive)" Link="core/Xray-macos-arm64-v8a.zip" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireBundledXray" BeforeTargets="PrepareForPublish">
    <Error Condition="!Exists('$(EgressXrayArchive)')" Text="Publishing requires the pinned offline Xray archive. Set EgressXrayArchive or prepare artifacts/core/Xray-macos-arm64-v8a.zip." />
  </Target>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop"/><PackageReference Include="CommunityToolkit.Mvvm"/>
    <ProjectReference Include="../EgressController.Desktop.Presentation/EgressController.Desktop.Presentation.csproj"/>
    <ProjectReference Include="../EgressController.Policy/EgressController.Policy.csproj"/>
    <ProjectReference Include="../EgressController.Runtime/EgressController.Runtime.csproj"/>
    <ProjectReference Include="../EgressController.Mac/EgressController.Mac.csproj"/>
  </ItemGroup>
  <Import Project="../../build/RiderProduction.targets" />
</Project>
