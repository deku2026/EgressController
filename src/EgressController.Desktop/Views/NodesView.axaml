<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EgressController.Desktop.ViewModels" xmlns:ui="using:EgressController.Desktop.Presentation.Controls" xmlns:views="using:EgressController.Desktop.Views" x:Class="EgressController.Desktop.Views.NodesView" x:DataType="vm:ShellViewModel">
 <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">
  <Border Classes="card" Padding="16,13"><Grid RowDefinitions="Auto,Auto" RowSpacing="10">
   <Grid ColumnDefinitions="*,210,Auto" ColumnSpacing="12">
    <StackPanel Orientation="Horizontal" Spacing="10"><ui:ProductAvatar Product="domain" Width="32" Height="32"/><StackPanel Spacing="3"><TextBlock Text="默认分组" FontWeight="SemiBold"/><TextBlock Text="新连接随分组切换 · 无需重启 TUN" Classes="caption" FontSize="10"/></StackPanel></StackPanel>
    <ComboBox Name="GlobalTargetBox" Grid.Column="1" ItemsSource="{Binding GlobalChoices}" SelectedItem="{Binding SelectedGlobalTarget,Mode=TwoWay}" VerticalAlignment="Center" PlaceholderText="选择默认分组"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:Choice"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
    <Button Grid.Column="2" Content="管理分组" Command="{Binding ManageGroupsCommand}"/>
   </Grid>
   <Expander Name="SubscriptionExpander" Grid.Row="1" Classes="local-import" Header="订阅与来源" HorizontalContentAlignment="Stretch">
    <StackPanel Spacing="9" Margin="0,9,0,0"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="9"><TextBox Name="SubscriptionUrlBox" Text="{Binding SubscriptionUrl,Mode=TwoWay}" PlaceholderText="Clash YAML 订阅 URL" AutomationProperties.Name="订阅URL"/><Button Grid.Column="1" Name="ImportSubscriptionButton" Content="更新订阅" Command="{Binding ImportSubscriptionCommand}"/></Grid><TextBlock Text="{Binding SubscriptionDescription}" Classes="caption" TextWrapping="Wrap"/><views:LocalSubscriptionView/></StackPanel>
   </Expander>
  </Grid></Border>
  <Border Grid.Row="1" IsVisible="{Binding ManagingGroups}" Classes="card" Padding="15"><views:GroupRetentionView/></Border>
  <Grid Grid.Row="2" ColumnDefinitions="*,250,Auto" ColumnSpacing="10"><TextBlock Text="{Binding GroupCountLabel}" Classes="caption"/><TextBox Grid.Column="1" Name="NodeSearch" Text="{Binding NodeQuery,Mode=TwoWay}" PlaceholderText="搜索分组或节点…" AutomationProperties.Name="搜索分组或节点"/><Button Grid.Column="2" Content="全部测速" Command="{Binding RunProbesCommand}" IsEnabled="{Binding CanEdit}"/></Grid>
  <Grid Grid.Row="3">
   <ListBox Name="ProxyGroupList" ItemsSource="{Binding VisibleGroups}" ItemContainerTheme="{StaticResource QuietRow}" Padding="0">
    <ListBox.ItemTemplate><DataTemplate x:DataType="vm:GroupRow">
     <Border Classes="group-card" Margin="0,0,0,10"><StackPanel>
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="6">
       <Button Classes="group-header" Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding Name}">
        <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="12">
         <ui:ProductAvatar Product="{Binding Product}" Width="38" Height="38"/>
         <StackPanel Grid.Column="1" Spacing="5"><StackPanel Orientation="Horizontal" Spacing="9"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/><Border Classes="group-badge" IsVisible="{Binding IsDefault}"><TextBlock Text="默认" FontSize="9" Foreground="{StaticResource Proxy}"/></Border></StackPanel><Grid ColumnDefinitions="Auto,*" ColumnSpacing="9"><TextBlock Text="{Binding Kind}" FontSize="10" Foreground="{StaticResource Proxy}"/><TextBlock Grid.Column="1" Text="{Binding Current}" FontSize="11" Foreground="{StaticResource SecondaryInk}" TextTrimming="CharacterEllipsis"/></Grid></StackPanel>
         <TextBlock Grid.Column="2" Text="{Binding Latency}" FontSize="12" Foreground="{StaticResource NonHome}" Margin="10,0"/>
        </Grid>
       </Button>
       <Button Grid.Column="1" Classes="quiet" Command="{Binding TestCommand}" ToolTip.Tip="测量这个分组的连接延迟" AutomationProperties.Name="分组延迟测速"><ui:Glyph Kind="refresh" Width="16" Height="16"/></Button>
       <Button Grid.Column="2" Classes="quiet" Command="{Binding ToggleCommand}" Padding="6" Width="30" AutomationProperties.Name="展开分组成员"><ui:Glyph Kind="{Binding Chevron}" Width="16" Height="16"/></Button>
      </Grid>
      <StackPanel IsVisible="{Binding Expanded}" Margin="18,0,18,17" Spacing="12">
       <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBlock Text="{Binding Detail}" Classes="caption" FontSize="10" TextWrapping="Wrap"/><Button Grid.Column="1" Content="自动优选" Command="{Binding AutomaticCommand}" FontSize="10"/><Button Grid.Column="2" Content="故障转移" Command="{Binding FallbackCommand}" FontSize="10"/></Grid>
       <ItemsControl ItemsSource="{Binding Members}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:GroupMemberRow">
        <Button Classes="group-member" Classes.selected="{Binding Selected}" Command="{Binding SelectCommand}" IsEnabled="{Binding CanSelect}" Width="210" MinHeight="77" Margin="0,0,9,9" ToolTip.Tip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
         <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8" ColumnSpacing="8"><TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding Selected}" Foreground="{StaticResource Proxy}"/><TextBlock Grid.Row="1" Text="{Binding Detail}" FontSize="9" Foreground="{StaticResource SecondaryInk}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Latency}" FontSize="10" Foreground="{StaticResource NonHome}"/></Grid>
        </Button>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
     </StackPanel></Border>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <TextBlock IsVisible="{Binding NoGroupsMatch}" Text="没有匹配的分组。导入订阅，或在「管理分组」中保留需要的分组。" Classes="caption" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"/>
  </Grid>
 </Grid>
</UserControl>
