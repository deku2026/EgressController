<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EgressController.MacApp.ViewModels" xmlns:ui="using:EgressController.Presentation" x:Class="EgressController.MacApp.Views.ApplicationsPage" x:DataType="vm:MacMainViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
    <Grid ColumnDefinitions="*,150,Auto" ColumnSpacing="12"><TextBox Text="{Binding Search}" PlaceholderText="搜索应用或路径"/><ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" HorizontalAlignment="Stretch"/><Button Grid.Column="2" Content="刷新应用" Command="{Binding RefreshApplicationsCommand}" IsEnabled="{Binding !Busy}"/></Grid>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBox Text="{Binding ManualPath}" PlaceholderText="手动添加 /Applications/Example.app 或原生命令绝对路径"/><Button Grid.Column="1" Content="添加路径" Command="{Binding AddApplicationCommand}" IsEnabled="{Binding !Busy}"/></Grid>
    <Border Grid.Row="2" Classes="list-card" Padding="12"><Grid RowDefinitions="Auto,*">
      <Grid ColumnDefinitions="36,*,120,220" Margin="8,5,8,12" ColumnSpacing="12"><TextBlock Grid.Column="1" Text="应用与匹配范围" Classes="muted" FontSize="12"/><TextBlock Grid.Column="2" Text="分类" Classes="muted" FontSize="12"/><TextBlock Grid.Column="3" Text="出口" Classes="muted" FontSize="12"/></Grid>
      <ListBox Grid.Row="1" ItemsSource="{Binding VisibleApplications}" ItemContainerTheme="{StaticResource TableRow}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:AppRow">
        <Grid ColumnDefinitions="28,*,120,220" ColumnSpacing="12" Margin="8,11"><CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center"/><Grid Grid.Column="1" ColumnDefinitions="34,*" ColumnSpacing="12"><ui:AppAvatar Width="32" Height="32" Source="{Binding Icon}" Cli="{Binding IsCli}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="{Binding Name}" FontWeight="Medium"/><TextBlock Text="{Binding Scope}" Classes="muted" FontSize="11"/><TextBlock Text="{Binding Path}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}"/></StackPanel></Grid><ComboBox Grid.Column="2" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Classes="category" VerticalAlignment="Center" HorizontalAlignment="Stretch"/><ComboBox Grid.Column="3" ItemsSource="{Binding Routes}" SelectedItem="{Binding Route}" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEnabled="{Binding Selected}"/>
        </Grid>
      </DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid></Border>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto"><TextBlock Text="新发现的应用保持未勾选；刷新保留原选择、顺序与出口。" Classes="muted" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding SelectedApps, StringFormat='已选 {0} 个应用'}" Classes="muted" FontSize="12"/></Grid>
  </Grid>
</UserControl>
