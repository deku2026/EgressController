<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EgressController.MacApp.ViewModels" x:Class="EgressController.MacApp.Views.EventsPage" x:DataType="vm:MacMainViewModel">
  <Grid RowDefinitions="Auto,*" RowSpacing="16"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="配置校验、恢复与连接检查的历史记录" Classes="muted" VerticalAlignment="Center"/><Button Grid.Column="1" Content="打开日志目录" Command="{Binding OpenLogsCommand}"/></Grid><Border Grid.Row="1" Classes="list-card" Padding="18"><Grid RowDefinitions="Auto,*"><TextBlock Text="历史事件与当前状态独立；操作恢复后不会保留错误横幅。" Classes="muted" FontSize="12" Margin="0,0,0,16"/><ListBox Grid.Row="1" ItemsSource="{Binding Logs}" ItemContainerTheme="{StaticResource TableRow}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:LogRow"><Grid ColumnDefinitions="80,150,*" ColumnSpacing="14" Margin="8,12"><TextBlock Text="{Binding Time}" Classes="muted"/><TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="Medium"/><TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border></Grid>
</UserControl>
