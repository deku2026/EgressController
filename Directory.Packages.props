<Project>

  <!-- Package versions are intentionally centralized for reproducible builds. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI (only referenced by EgressController.App). -->
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.11" />

    <!-- Windows interop. -->
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.321" />

    <!-- DI, logging, and options. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />

    <!-- Local application traffic history. SQLite uses the Windows system provider in the AOT app. -->
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.11" />
    <PackageVersion Include="SQLitePCLRaw.bundle_winsqlite3" Version="2.1.11" />

    <PackageVersion Include="PuppeteerSharp" Version="25.15.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.85.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.85.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />

    <!-- Tests use xUnit v3 and Microsoft.Testing.Platform via global.json. -->
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

</Project>
