<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EgressController.Desktop.ViewModels" xmlns:ui="using:EgressController.Desktop.Presentation.Controls" x:Class="EgressController.Desktop.Views.ResetConfigurationOverlay" x:DataType="vm:ShellViewModel" KeyboardNavigation.TabNavigation="Cycle">
 <UserControl.KeyBindings><KeyBinding Gesture="Escape" Command="{Binding CancelResetCommand}"/></UserControl.KeyBindings>
 <Border Background="#70303B50" Padding="30"><Border Background="{StaticResource Surface}" BorderBrush="#DDE5F0" BorderThickness="1" CornerRadius="17" Width="500" MaxHeight="570" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 16 60 0 #30394A70">
  <Grid RowDefinitions="Auto,*,Auto">
   <StackPanel Margin="28,26,28,20" Spacing="13"><Border Background="#FFF1F2" Width="40" Height="40" CornerRadius="11" HorizontalAlignment="Left"><ui:Glyph Kind="settings" Width="23" Height="23" Foreground="#AD5061"/></Border><TextBlock Text="重置并重新设置" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="备份当前设置，清空配置，从第一步重新开始。" Classes="caption" TextWrapping="Wrap"/></StackPanel>
   <ScrollViewer Grid.Row="1" Margin="28,0" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="16">
    <Border Classes="inset"><StackPanel Spacing="9"><TextBlock Text="将清空" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="网卡选择、订阅与节点、分组、应用分流、规则、DNS 与端口，以及旧订阅缓存、测速临时文件和生成配置。" Classes="caption" TextWrapping="Wrap" LineHeight="20"/></StackPanel></Border>
    <StackPanel Spacing="7"><TextBlock Text="原配置会先保存为本地备份" FontWeight="Medium" FontSize="12"/><TextBlock Text="会尝试停止连接并恢复网络。助手不可用也能重置设置，网络恢复可单独修复。日志、用量和独立备份保留；后台旧配置在网络恢复后清除。" Classes="caption" TextWrapping="Wrap" LineHeight="20"/></StackPanel>
    <Border IsVisible="{Binding HasResetIssue}" Background="#FFF1F2" CornerRadius="8" Padding="12"><StackPanel Spacing="10"><TextBlock Text="{Binding ResetIssue}" Foreground="{StaticResource Danger}" FontSize="11" TextWrapping="Wrap"/><Button Content="打开日志目录" Command="{Binding ShowLogDirectoryCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
    <TextBlock IsVisible="{Binding IsBusy}" Text="正在备份并重置设置…" Classes="caption"/>
   </StackPanel></ScrollViewer>
   <Border Grid.Row="2" BorderBrush="#E8EDF4" BorderThickness="0,1,0,0" Padding="28,18" Margin="0,23,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="9"><Button Name="CancelResetButton" Content="保留当前设置" Command="{Binding CancelResetCommand}"/><Button Name="ConfirmResetButton" Content="确认重置" Command="{Binding ConfirmResetCommand}" Classes="primary"/></StackPanel></Border>
  </Grid>
 </Border></Border>
</UserControl>
