<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EgressController.Desktop.ViewModels" xmlns:ui="using:EgressController.Desktop.Presentation.Controls" x:Class="EgressController.Desktop.Views.ApplicationsView" x:DataType="vm:ShellViewModel">
 <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14"><TextBox Name="AppSearch" Text="{Binding AppQuery,Mode=TwoWay}" PlaceholderText="搜索已管理的应用…" HorizontalAlignment="Left" Width="300" AutomationProperties.Name="搜索已管理应用"/><Button Name="AddAppsButton" Grid.Column="1" Classes="primary" Command="{Binding AddAppsCommand}"><StackPanel Orientation="Horizontal" Spacing="6"><ui:Glyph Kind="plus" Width="14" Height="14" Foreground="White"/><TextBlock Text="添加应用"/></StackPanel></Button></Grid>
  <Border Grid.Row="1" Classes="card" Padding="0"><Grid RowDefinitions="Auto,Auto,*,Auto"><Grid Margin="18,16" ColumnDefinitions="*,Auto"><TextBlock Text="{Binding ApplicationCountLabel}" Classes="section"/><TextBlock Grid.Column="1" Text="已保存的固定清单" FontSize="10" Foreground="#95A0B2"/></Grid><Border Grid.Row="1" Classes="tableheader"><Grid ColumnDefinitions="*,265,34" ColumnSpacing="12"><TextBlock Text="应用" Classes="caption" FontSize="10"/><TextBlock Grid.Column="1" Text="出口策略" Classes="caption" FontSize="10"/></Grid></Border>
   <ListBox Grid.Row="2" Name="ManagedAppList" ItemsSource="{Binding VisibleApps}" SelectedItem="{Binding SelectedApp,Mode=TwoWay}" ItemContainerTheme="{StaticResource QuietRow}"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:AppRow"><Grid ColumnDefinitions="38,*,265,28" ColumnSpacing="12" Margin="11,12"><ui:ProductAvatar Product="{Binding Product}" Width="36" Height="36"/><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Classes="caption" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center"><ui:RoutePicker SelectedIndex="{Binding RouteIndex,Mode=TwoWay}"/><ComboBox IsVisible="{Binding ProxyVisible}" ItemsSource="{Binding ProxyChoices}" SelectedItem="{Binding SelectedProxyTarget,Mode=TwoWay}" PlaceholderText="选择具体节点或分组" MinHeight="25" Padding="8,3" FontSize="10"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:Choice"><TextBlock Text="{Binding Name}" FontSize="10"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel><Button Grid.Column="3" Content="×" Classes="quiet" Padding="0" Width="26" MinHeight="27" Command="{Binding RemoveCommand}" ToolTip.Tip="移除单独分流" AutomationProperties.Name="移除应用"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
   <TextBlock Grid.Row="2" IsVisible="{Binding NoAppsMatch}" Text="没有匹配的已管理应用，试试其他名称。" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   <StackPanel Grid.Row="2" IsVisible="{Binding AppsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"><ui:Glyph Kind="apps" Width="42" Height="42" Foreground="#BCC8DC" HorizontalAlignment="Center"/><TextBlock Text="先为一个应用选择出口" FontSize="15" FontWeight="Medium" HorizontalAlignment="Center"/><TextBlock Text="添加已安装的 App，策略会在它关闭后继续保留。" Classes="caption"/><Button Content="添加第一个应用" Command="{Binding AddAppsCommand}" Classes="primary" HorizontalAlignment="Center"/></StackPanel>
   <Border Grid.Row="3" BorderBrush="#ECF0F5" BorderThickness="0,1,0,0" Padding="17,12"><TextBlock Text="只使用显式保存的可执行路径 · 出口更改保留原有清单" FontSize="10" Foreground="#96A0B1"/></Border>
  </Grid></Border>
  <Border Grid.Row="2" IsVisible="{Binding HasSelectedApp}" Classes="card" Padding="16,12"><Grid RowDefinitions="Auto,Auto" RowSpacing="9"><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="{Binding SelectedAppName}" FontWeight="Medium" FontSize="11"/><TextBlock Text="固定可执行路径" Classes="caption" FontSize="10"/></StackPanel><Button Grid.Column="1" Content="显式刷新示例清单" Classes="link" FontSize="10" Command="{Binding RefreshSelectedInventoryCommand}"/></Grid><ScrollViewer Grid.Row="1" MaxHeight="95"><ItemsControl ItemsSource="{Binding SelectedAppPaths}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" FontFamily="Menlo,Consolas" FontSize="9" Foreground="#8B97AC" Margin="0,3" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border>
  <Border Grid.RowSpan="3" IsVisible="{Binding AddingApps}" Background="#F8F9FC" CornerRadius="10"><Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="7"><TextBlock Text="添加已安装的应用" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="先搜索，再明确选择。AI、开发、浏览器与日常应用均可添加。" Classes="muted" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="取消" Command="{Binding CancelAppsCommand}" VerticalAlignment="Top"/></Grid><TextBox Grid.Row="1" Name="CatalogSearch" Text="{Binding CatalogQuery,Mode=TwoWay}" PlaceholderText="搜索应用名称或分类…" AutomationProperties.Name="搜索已安装应用"/>
   <Border Grid.Row="2" Classes="card" Padding="4"><Grid><ListBox ItemsSource="{Binding VisibleCatalog}" ItemContainerTheme="{StaticResource QuietRow}"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:CatalogRow"><Grid ColumnDefinitions="28,38,*,Auto" ColumnSpacing="12" Margin="12,12"><CheckBox IsEnabled="{Binding CanSelect}" IsChecked="{Binding IsSelected,Mode=TwoWay}" AutomationProperties.Name="{Binding Name}"/><ui:ProductAvatar Grid.Column="1" Product="{Binding Product}" Width="36" Height="36"/><StackPanel Grid.Column="2" Spacing="5"><TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="13"/><TextBlock Text="{Binding Subtitle}" Classes="caption" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="3" IsVisible="{Binding IsManaged}" Text="已管理" FontSize="10" Foreground="#A0ACBD"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock IsVisible="{Binding NoCatalogMatch}" Text="没有找到匹配应用，试试其他名称或分类。" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
   <Grid Grid.Row="3" ColumnDefinitions="*,Auto"><TextBlock Text="新应用默认未勾选 · 添加时保存固定 Helper 清单" FontSize="10" Foreground="#8E9AAD"/><Button Name="ConfirmAddAppsButton" Grid.Column="1" Classes="primary" Content="{Binding AddSelectedLabel}" Command="{Binding ConfirmAppsCommand}"/></Grid>
  </Grid></Border>
 </Grid>
</UserControl>
