<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EgressController.Desktop.ViewModels" xmlns:views="using:EgressController.Desktop.Views" xmlns:ui="using:EgressController.Desktop.Presentation.Controls" x:Class="EgressController.Desktop.Views.SetupOverlay" x:DataType="vm:ShellViewModel" KeyboardNavigation.TabNavigation="Cycle">
 <UserControl.KeyBindings><KeyBinding Gesture="Escape" Command="{Binding CloseSetupCommand}"/></UserControl.KeyBindings>
 <Border Background="#70303B50" Padding="25"><Border Background="#FCFDFE" BorderBrush="#DDE5F0" BorderThickness="1" CornerRadius="17" Width="610" MaxHeight="660" HorizontalAlignment="Center" VerticalAlignment="Stretch" BoxShadow="0 16 60 0 #30394A70"><Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
  <Grid Margin="28,23,25,0" ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8"><Border Background="#EAF0FC" Width="27" Height="27" CornerRadius="7"><ui:Glyph Kind="arrow" Width="18" Height="18" Foreground="#6D8BC1"/></Border><TextBlock Text="让网络各行其道" FontSize="12" FontWeight="Medium" Foreground="{StaticResource SecondaryInk}"/><TextBlock IsVisible="{Binding IsPreview}" Text="PREVIEW" FontSize="8" Foreground="{StaticResource Warning}" LetterSpacing="1"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5"><Button IsVisible="{Binding IsBusy}" Content="取消操作" Classes="quiet" Command="{Binding CancelOperationCommand}"/><Button Content="×" AutomationProperties.Name="关闭设置向导" Classes="quiet" Command="{Binding CloseSetupCommand}" Padding="0" Width="28" FontSize="20"/></StackPanel></Grid>
<StackPanel Grid.Row="1" Spacing="8" Margin="30,22,30,18"><TextBlock Text="{Binding SetupProgress}" FontSize="10" LetterSpacing="1.3" Foreground="{StaticResource SecondaryInk}"/><TextBlock Name="SetupStepTitle" Focusable="True" TextWrapping="Wrap" Text="{Binding SetupTitle}" FontSize="24" FontWeight="SemiBold" LetterSpacing="-.7"/><TextBlock Text="{Binding SetupDescription}" FontSize="12" Foreground="{StaticResource SecondaryInk}" TextWrapping="Wrap" LineHeight="21"/></StackPanel>
  <StackPanel Grid.Row="2" Spacing="12" Margin="30,0,30,12"><views:NetworkRecoveryNotice IsVisible="{Binding HasRecoveryIssue}" Margin="0"/><Border Name="SetupErrorPanel" IsVisible="{Binding HasIssue}" Background="#FFF1F2" BorderBrush="#F0D8DD" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0">
   <StackPanel Spacing="9"><TextBlock Text="这一步尚未完成" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Danger}"/>
    <ScrollViewer MaxHeight="96" HorizontalScrollBarVisibility="Disabled"><SelectableTextBlock Name="SetupErrorText" Text="{Binding CurrentIssue}" Foreground="{StaticResource Danger}" FontSize="11" TextWrapping="Wrap"/></ScrollViewer>
    <StackPanel Orientation="Horizontal" Spacing="8"><Button Name="SetupViewDiagnosticsButton" Content="查看诊断" Command="{Binding OpenLogsCommand}" FontSize="11"/><Button Name="SetupOpenLogDirectoryButton" Content="打开日志目录" Command="{Binding ShowLogDirectoryCommand}" FontSize="11"/><Button Name="SetupResetButton" Content="重置并重新设置" Command="{Binding RequestResetCommand}" FontSize="11"/></StackPanel>
   </StackPanel>
  </Border></StackPanel>
  <ScrollViewer Name="SetupContentScroll" IsVisible="{Binding SetupScrollContent}" Grid.Row="3" Margin="30,0,30,0" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="16">

   <StackPanel IsEnabled="{Binding CanEdit}" IsVisible="{Binding SetupInterfaces}" Spacing="18"><Border Classes="card" Padding="18"><StackPanel Spacing="10"><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Fill="{StaticResource Home}" Width="6" Height="6"/><TextBlock Text="家宽网络" FontSize="12" FontWeight="Medium"/></StackPanel><ComboBox PlaceholderText="选择物理网卡" ItemsSource="{Binding InterfaceChoices}" SelectedItem="{Binding SelectedHomeInterface,Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:Choice"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel></Border><Border Classes="card" Padding="18"><StackPanel Spacing="10"><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Fill="{StaticResource NonHome}" Width="6" Height="6"/><TextBlock Text="非家宽网络" FontSize="12" FontWeight="Medium"/></StackPanel><ComboBox PlaceholderText="选择物理网卡" ItemsSource="{Binding InterfaceChoices}" SelectedItem="{Binding SelectedNonHomeInterface,Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:Choice"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel></Border><StackPanel Name="HomeCheckFeedback" Spacing="10">
    <Button Name="HomeConnectivityButton" Command="{Binding CheckHomeCommand}" HorizontalAlignment="Left" Classes="soft" AutomationProperties.Name="检测家宽连接" AutomationProperties.HelpText="仅使用所选家宽网卡，检测成功后才能继续。"><StackPanel Orientation="Horizontal" Spacing="7"><ui:Glyph Kind="gauge" Width="16" Height="16"/><TextBlock Text="检测家宽连接"/></StackPanel></Button>
    <TextBlock Name="HomeConnectivityStatus" Text="{Binding HomeCheckStatus}" Classes="caption" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    <Border Name="HomeConnectivityHelp" IsVisible="{Binding HomeCheckFailed}" Classes="inset" Padding="14" AutomationProperties.Name="家宽连接排查">
     <Grid ColumnDefinitions="18,*" ColumnSpacing="10"><ui:Glyph Kind="network" Width="18" Height="18" Foreground="{StaticResource HomeInk}" VerticalAlignment="Top" Margin="0,2,0,0"/>
      <StackPanel Grid.Column="1" Spacing="7">
       <TextBlock Text="iPhone USB 显示 Attached？" FontSize="12" FontWeight="SemiBold"/>
       <TextBlock Text="Attached 表示设备已接入，不代表网络已连接。若关闭 Wi‑Fi 后才能上网，请检查 Mac 的按需停用设置。" Classes="caption" TextWrapping="Wrap" LineHeight="18"/>
       <TextBlock Text="系统设置 → 网络 → iPhone USB → 详细信息" FontSize="11" FontWeight="Medium" TextWrapping="Wrap"/>
       <TextBlock Text="关闭 Disable unless needed（除非需要，否则停用）。保持 iPhone 个人热点和 Wi‑Fi 开启，等 USB 显示 Connected、获取 IP 后重新检测。" Classes="caption" TextWrapping="Wrap" LineHeight="18"/>
      </StackPanel>
     </Grid>
    </Border>
   </StackPanel><TextBlock Text="指定出口失效时连接失败，不允许静默切换网卡。" FontSize="10" Foreground="{StaticResource SecondaryInk}"/></StackPanel>
   <StackPanel IsEnabled="{Binding CanEdit}" IsVisible="{Binding SetupSubscription}" Spacing="15"><TextBlock Text="Clash YAML 订阅 URL" FontSize="12" FontWeight="Medium"/><TextBox Text="{Binding SubscriptionUrl,Mode=TwoWay}" FontSize="11"/><Button Name="SetupImportSubscriptionButton" Content="{Binding ImportLabel}" Command="{Binding ImportSubscriptionCommand}" Classes="primary" HorizontalAlignment="Left"/><TextBlock Text="{Binding SetupSubscriptionStatus}" FontSize="10" Foreground="{StaticResource SecondaryInk}"/><Border Classes="inset"><TextBlock Text="{Binding SubscriptionDescription}" FontSize="11" Foreground="{StaticResource SecondaryInk}" TextWrapping="Wrap" LineHeight="20"/></Border><Border Name="SubscriptionDnsRepairPanel" Classes="inset"><StackPanel Spacing="10"><views:DnsEndpointEditor Name="SetupDnsEditor"/><Button Name="RetrySubscriptionDnsButton" IsVisible="{Binding ShowSubscriptionDnsRetry}" Content="使用此 DNS 重试" Classes="soft" HorizontalAlignment="Left" Command="{Binding ImportSubscriptionCommand}"/></StackPanel></Border><views:LocalSubscriptionView/></StackPanel>
   <StackPanel IsVisible="{Binding SetupReview}" Spacing="16"><views:ConnectionAttemptView DataContext="{Binding ConnectionAttempt}"/><Border Background="#F3F6FC" CornerRadius="11" Padding="22"><StackPanel Spacing="12"><ui:Glyph Kind="shield" Width="38" Height="38" Foreground="#7593BD" HorizontalAlignment="Center"/><TextBlock Text="配置已收集，先启动 Xray TUN，再准备规则。" FontSize="14" FontWeight="Medium" HorizontalAlignment="Center"/><TextBlock Text="{Binding SetupApplyDescription}" FontSize="11" Foreground="{StaticResource SecondaryInk}" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel></Border><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="14"><TextBlock Text="家宽" FontSize="11" Foreground="{StaticResource SecondaryInk}"/><TextBlock Grid.Column="1" Text="{Binding HomeInterfaceName}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding HomeInterfaceName}"/><TextBlock Grid.Row="1" Text="全球代理" FontSize="11" Foreground="{StaticResource SecondaryInk}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GlobalTargetName}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding GlobalTargetName}"/></Grid></StackPanel>
  </StackPanel></ScrollViewer>
   <Grid Grid.Row="3" Margin="30,0" IsEnabled="{Binding CanEdit}" IsVisible="{Binding SetupGlobal}" RowDefinitions="Auto,*,Auto" RowSpacing="14">
    <Grid ColumnDefinitions="*,220" ColumnSpacing="14"><StackPanel Spacing="4"><TextBlock Text="默认分组" FontWeight="SemiBold"/><TextBlock Text="其余流量使用此分组" Classes="caption" FontSize="10"/></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding GlobalChoices}" SelectedItem="{Binding SelectedGlobalTarget,Mode=TwoWay}" PlaceholderText="选择默认分组"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:Choice"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
    <views:GroupRetentionView Grid.Row="1"/>
    <Border Grid.Row="2" Classes="inset"><TextBlock Text="{Binding AutomaticDownloadDescription}" Classes="caption" TextWrapping="Wrap" LineHeight="19"/></Border>
   </Grid>
   <Grid Grid.Row="3" Margin="30,0" IsEnabled="{Binding CanEdit}" IsVisible="{Binding SetupApplications}" RowDefinitions="Auto,Auto,*" RowSpacing="12"><TextBlock Text="勾选需要添加的应用，点击「继续」保存；已管理的应用保留。" FontSize="11" Foreground="{StaticResource SecondaryInk}"/><TextBox Grid.Row="1" Name="SetupApplicationSearch" Text="{Binding CatalogQuery,Mode=TwoWay}" PlaceholderText="搜索应用名称、Bundle ID 或路径，例如 Safari…" AutomationProperties.Name="首次设置搜索应用"/><TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" ZIndex="1" IsVisible="{Binding NoCatalogMatch}" Text="没有找到匹配的应用，请更换关键词。" Classes="caption"/><Border Grid.Row="2" Classes="card" Padding="5"><ListBox ItemsSource="{Binding VisibleCatalog}" ItemContainerTheme="{StaticResource QuietRow}"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:CatalogRow"><Grid ColumnDefinitions="26,30,*" ColumnSpacing="10" Margin="8,8"><CheckBox IsEnabled="{Binding CanSelect}" IsChecked="{Binding IsSelected,Mode=TwoWay}"/><ui:ProductAvatar Grid.Column="1" Source="{Binding Icon}" Product="{Binding Product}" Width="28" Height="28"/><TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border></Grid>

  <Border Grid.Row="4" BorderBrush="#E8EDF4" BorderThickness="0,1,0,0" Padding="28,18" Margin="0,16,0,0"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="9"><TextBlock Text="{Binding SetupPermissionText}" FontSize="10" Foreground="{StaticResource SecondaryInk}"/><Button Grid.Column="1" Content="上一步" Command="{Binding BackSetupCommand}"/><Button Name="SetupContinueButton" Grid.Column="2" Content="{Binding NextSetupLabel}" Command="{Binding NextSetupCommand}" Classes="primary" MinWidth="90"/></Grid></Border>
 </Grid></Border></Border>
</UserControl>
