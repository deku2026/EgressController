root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets,xml,axaml,slnx,ps1}]
end_of_line = crlf
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4

[*.{md,yml,yaml,json}]
end_of_line = lf
indent_style = space
indent_size = 2

[LICENSE]
end_of_line = lf
