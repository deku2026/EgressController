<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EgressController.Desktop.ViewModels" xmlns:views="using:EgressController.Desktop.Views" xmlns:ui="using:EgressController.Desktop.Presentation.Controls" x:Class="EgressController.Desktop.Views.MainWindow" x:DataType="vm:ShellViewModel" Title="{Binding WindowTitle}" Width="1260" Height="860" MinWidth="960" MinHeight="660" WindowStartupLocation="CenterScreen" WindowDecorations="Full">
 <Grid ColumnDefinitions="202,*">
  <Border Background="{StaticResource Sidebar}" BorderBrush="#E5E9F1" BorderThickness="0,0,1,0">
   <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="15,25,15,17">
    <StackPanel Margin="9,0,0,0" Spacing="12">
     <StackPanel Orientation="Horizontal" Spacing="10"><Border Background="#2A3A58" CornerRadius="10" Width="36" Height="36"><ui:Glyph Kind="arrow" Foreground="White" Width="24" Height="24" RenderTransformOrigin="50%,50%"><ui:Glyph.RenderTransform><RotateTransform Angle="-35"/></ui:Glyph.RenderTransform></ui:Glyph></Border><StackPanel Spacing="1"><TextBlock Text="Egress" FontSize="21" FontWeight="SemiBold" LetterSpacing="-.5"/><TextBlock Text="NETWORK, INTENTIONALLY." FontSize="7.5" Foreground="#8A95A8" LetterSpacing="1"/></StackPanel></StackPanel>
     <TextBlock Text="我的 Mac" FontSize="11" Foreground="#8A95A8" Margin="0,12,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Spacing="5" Margin="0,12,0,0">
     <Button Name="OverviewNav" Classes="navigation" Classes.active="{Binding OverviewVisible}" Command="{Binding OverviewCommand}"><Grid ColumnDefinitions="22,*,Auto" ColumnSpacing="10"><ui:Glyph Kind="overview" Width="18" Height="18"/><TextBlock Grid.Column="1" Text="总览"/><TextBlock Grid.Column="2" Text="⌘1" FontSize="10" Foreground="#A2ABBA"/></Grid></Button>
     <Button Name="AppsNav" Classes="navigation" Classes.active="{Binding AppsVisible}" Command="{Binding AppsCommand}"><Grid ColumnDefinitions="22,*,Auto" ColumnSpacing="10"><ui:Glyph Kind="apps" Width="19" Height="19"/><TextBlock Grid.Column="1" Text="应用分流"/><TextBlock Grid.Column="2" Text="{Binding ApplicationCount}" FontSize="11" Foreground="#8A95A8"/></Grid></Button>
     <Button Name="RulesNav" Classes="navigation" Classes.active="{Binding RulesVisible}" Command="{Binding RulesCommand}"><Grid ColumnDefinitions="22,*,Auto" ColumnSpacing="10"><ui:Glyph Kind="rules" Width="18" Height="18"/><TextBlock Grid.Column="1" Text="规则集合"/><TextBlock Grid.Column="2" Text="{Binding RuleCount}" FontSize="11" Foreground="#8A95A8"/></Grid></Button>
     <Button Name="NodesNav" Classes="navigation" Classes.active="{Binding NodesVisible}" Command="{Binding NodesCommand}"><Grid ColumnDefinitions="22,*" ColumnSpacing="10"><ui:Glyph Kind="nodes" Width="19" Height="19"/><TextBlock Grid.Column="1" Text="节点与分组"/></Grid></Button>
    </StackPanel>
    <StackPanel Grid.Row="3" Spacing="11">
     <Button Name="SettingsNav" Classes="navigation" Classes.active="{Binding SettingsVisible}" Command="{Binding SettingsCommand}"><Grid ColumnDefinitions="22,*" ColumnSpacing="10"><ui:Glyph Kind="settings" Width="18" Height="18"/><TextBlock Grid.Column="1" Text="设置"/></Grid></Button>
     <Border Height="1" Background="#E0E5EF" Margin="9,0"/>
     <Button Classes="quiet" Command="{Binding OpenLogsCommand}" HorizontalContentAlignment="Left" Padding="12,7"><StackPanel Orientation="Horizontal" Spacing="10"><ui:Glyph Kind="logs" Width="16" Height="16"/><TextBlock Text="日志与诊断" FontSize="11"/></StackPanel></Button>
     <StackPanel Margin="12,0" Spacing="5"><StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Fill="{Binding ModeBrush}" Width="5" Height="5"/><TextBlock Text="{Binding ModeLabel}" FontSize="10" Foreground="{Binding ModeBrush}"/></StackPanel><TextBlock Text="macOS · Xray only" FontSize="10" Foreground="#9CA5B5"/></StackPanel>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto">
   <Grid Margin="30,25,30,23" ColumnDefinitions="*,Auto" ColumnSpacing="16">
    <StackPanel Spacing="7"><TextBlock Classes="title" Text="{Binding PageTitle}"/><TextBlock Classes="muted" Text="{Binding PageDescription}"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="11" VerticalAlignment="Center"><TextBlock Classes="caption" Text="{Binding SaveStatus}"/><Button Content="取消操作" Command="{Binding CancelOperationCommand}" IsVisible="{Binding IsBusy}" Classes="quiet" FontSize="10"/><Border IsVisible="{Binding IsPreview}" Background="#FFF8EB" BorderBrush="#F0E3C8" BorderThickness="1" CornerRadius="5" Padding="8,4"><TextBlock Text="PREVIEW" FontSize="9" FontWeight="SemiBold" LetterSpacing=".9" Foreground="#A17E40"/></Border></StackPanel>
   </Grid>
   <StackPanel Grid.Row="1"><Border IsVisible="{Binding HasIssue}" Background="#FFF0F0" BorderBrush="#F1D6D9" BorderThickness="1" CornerRadius="8" Margin="30,0,30,16" Padding="13,10"><TextBlock Text="{Binding CurrentIssue}" Foreground="#A74958" FontSize="12" TextWrapping="Wrap"/></Border><views:ConnectionAttemptView DataContext="{Binding ConnectionAttempt}" Margin="30,0,30,15"/></StackPanel>
   <Grid Grid.Row="2" Margin="30,0,30,22" IsEnabled="{Binding CanEdit}">
    <views:OverviewView IsVisible="{Binding OverviewVisible}"/><views:ApplicationsView IsVisible="{Binding AppsVisible}"/><views:RulesView IsVisible="{Binding RulesVisible}"/><views:NodesView IsVisible="{Binding NodesVisible}"/><views:SettingsView IsVisible="{Binding SettingsVisible}"/>
   </Grid>
   <Border Grid.Row="3" BorderBrush="#E9ECF2" BorderThickness="0,1,0,0" Background="#FCFDFE" Padding="29,10"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock Text="{Binding Notice}" FontSize="10" Foreground="#8993A5" TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" Classes="link" Content="查看诊断" Command="{Binding OpenLogsCommand}" FontSize="10" MinHeight="18"/></Grid></Border>
  </Grid>
  <views:SetupOverlay Grid.ColumnSpan="2" IsVisible="{Binding OnboardingVisible}"/>
 </Grid>
 <Window.KeyBindings><KeyBinding Gesture="Meta+1" Command="{Binding OverviewCommand}"/><KeyBinding Gesture="Meta+2" Command="{Binding AppsCommand}"/><KeyBinding Gesture="Meta+3" Command="{Binding RulesCommand}"/><KeyBinding Gesture="Meta+4" Command="{Binding NodesCommand}"/></Window.KeyBindings>
</Window>
