<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EgressController.MacApp.ViewModels" x:Class="EgressController.MacApp.Views.ConfigurationPage" x:DataType="vm:MacMainViewModel">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
    <Border Classes="card" Padding="18"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel Spacing="6"><TextBlock Text="{Binding ConfigStatus}" Classes="card-title"/><TextBlock Text="独立的 EgressController Profile · 校验不会切换当前配置" Classes="muted" FontSize="12"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="恢复有效文件" Command="{Binding RestoreCommand}" IsEnabled="{Binding !Busy}"/><Button Content="生成并校验" Classes="primary" Command="{Binding PrepareCommand}" IsEnabled="{Binding !Busy}"/></StackPanel></Grid></Border>
    <Border Grid.Row="1" Classes="card" Padding="16"><TextBox Name="ConfigurationText" Text="{Binding ConfigText}" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" FontFamily="Menlo,Consolas" FontSize="12" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/></Border>
    <Border Grid.Row="2" Background="#EAF0FA" CornerRadius="9" Padding="14"><StackPanel Spacing="6"><TextBlock Text="校验通过后，在 Surge 中导入并手动应用" FontWeight="Medium"/><SelectableTextBlock Text="{Binding ExportLocation}" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="未实际切换时保持“待应用”；管理器不会自动重载你的网络。" Classes="muted" FontSize="12"/></StackPanel></Border>
  </Grid>
</UserControl>
