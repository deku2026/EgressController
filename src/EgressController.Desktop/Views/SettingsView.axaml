<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EgressController.Desktop.ViewModels" xmlns:ui="using:EgressController.Desktop.Presentation.Controls" xmlns:views="using:EgressController.Desktop.Views" x:Class="EgressController.Desktop.Views.SettingsView" x:DataType="vm:ShellViewModel">
 <Grid RowDefinitions="*,Auto" RowSpacing="17">
  <TabControl Name="SettingsTabs" SelectedIndex="{Binding SettingsTab,Mode=TwoWay}">
   <TabItem Header="网络与 TUN"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="17" Margin="0,19,0,0">
    <Border Classes="card"><Grid ColumnDefinitions="*,160" ColumnSpacing="20"><StackPanel Spacing="7"><TextBlock Text="Xray 本地代理端口" Classes="section"/><TextBlock Text="默认启用 TUN。资源下载经此 SOCKS5 端口，使用非家宽分组节点。" Classes="caption" TextWrapping="Wrap"/></StackPanel><NumericUpDown Grid.Column="1" ShowButtonSpinner="False" VerticalAlignment="Center" Minimum="1024" Maximum="65535" Value="{Binding ResourceProxyPort,Mode=TwoWay}" FormatString="0" AutomationProperties.Name="Xray 本地 SOCKS5 端口"/></Grid></Border>
    <Border Classes="card"><StackPanel Spacing="19"><StackPanel Spacing="6"><TextBlock Text="物理出口" Classes="section"/><TextBlock Text="使用稳定接口身份保存选择，网卡名称变化不会改变策略。" Classes="caption"/></StackPanel><Grid ColumnDefinitions="*,*" ColumnSpacing="24"><StackPanel Spacing="10"><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Fill="{StaticResource Home}" Width="6" Height="6"/><TextBlock Text="家宽网卡" FontSize="12"/></StackPanel><ComboBox Name="HomeInterfaceBox" ItemsSource="{Binding InterfaceChoices}" SelectedItem="{Binding SelectedHomeInterface,Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:Choice"><TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="物理出口 A · 仅供显式家宽策略使用" FontSize="10" Foreground="{StaticResource HomeInk}"/></StackPanel><StackPanel Grid.Column="1" Spacing="10"><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Fill="{StaticResource NonHome}" Width="6" Height="6"/><TextBlock Text="非家宽网卡" FontSize="12"/></StackPanel><ComboBox Name="NonHomeInterfaceBox" ItemsSource="{Binding InterfaceChoices}" SelectedItem="{Binding SelectedNonHomeInterface,Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:Choice"><TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="物理出口 B · 国内默认与代理节点连接" FontSize="10" Foreground="{StaticResource NonHomeInk}"/></StackPanel></Grid><Border Height="1" Background="#EBEEF4"/><TextBlock Text="出口不可用时连接失败，禁止回退到另一张网卡。" FontSize="11" Foreground="{StaticResource SecondaryInk}"/></StackPanel></Border>
    <Border Classes="card"><Grid ColumnDefinitions="35,*,Auto" ColumnSpacing="13"><ui:Glyph Kind="shield" Width="29" Height="29" Foreground="#8A9FBE"/><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="Xray 原生 TUN" Classes="section"/><TextBlock Text="仅在授权后由特权服务管理 DNS、路由与网络恢复。" Classes="caption"/><TextBlock TextWrapping="Wrap" Text="{Binding TunDescription}" FontSize="10" Foreground="{StaticResource Warning}"/></StackPanel><Border Grid.Column="2" Background="#F2F5FA" CornerRadius="5" Padding="9,5" VerticalAlignment="Top"><TextBlock Text="{Binding TunStatusText}" FontSize="10" Foreground="{StaticResource SecondaryInk}"/></Border></Grid></Border>
    <Border Classes="card"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel Spacing="7"><TextBlock Text="重新设置工作空间" Classes="section"/><TextBlock Text="备份当前配置并清理旧缓存，从头设置；诊断日志保留。" Classes="caption" TextWrapping="Wrap"/><Button Content="重新检查设置（保留配置）" Classes="link" Command="{Binding BeginSetupCommand}" HorizontalAlignment="Left"/></StackPanel><Button Grid.Column="1" Name="SettingsResetButton" Content="重置并重新设置" Command="{Binding RequestResetCommand}" VerticalAlignment="Center"/></Grid></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="DNS"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="18" Margin="0,19,0,0"><Border Classes="card"><StackPanel Spacing="19"><StackPanel Spacing="6"><TextBlock Text="真实 IP 解析" Classes="section"/><TextBlock Text="不默认使用 Fake-IP，域名与 IP 规则共同完成匹配。" Classes="caption"/></StackPanel><views:DnsEndpointEditor/><Border Height="1" Background="#EBEEF4"/><StackPanel Spacing="11"><TextBlock Text="常规 DNS → TUN → 加密 DNS · 非家宽" FontSize="12" FontWeight="Medium"/><TextBlock Text="域名嗅探辅助 HTTP、TLS 与 QUIC。应用自带加密 DNS、ECH 或纯 IP 连接仍由 IP 集合兜底。" Classes="caption" TextWrapping="Wrap" LineHeight="20"/></StackPanel></StackPanel></Border><Border Classes="inset"><TextBlock Text="{Binding DnsDescription}" FontSize="10" Foreground="{StaticResource SecondaryInk}" TextWrapping="Wrap"/></Border></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="DSL 配置"><Grid RowDefinitions="Auto,*" RowSpacing="13" Margin="0,18,0,0"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><StackPanel Spacing="5"><TextBlock Text="一份配置，统一所有策略" Classes="section"/><TextBlock Text="编辑 YAML，校验通过后同步到界面与 Xray 生成配置。" Classes="caption" FontSize="10"/></StackPanel><Button Grid.Column="1" Content="从界面重置" Command="{Binding ResetDslCommand}"/><Button Grid.Column="2" Content="校验并同步" Command="{Binding ApplyDslCommand}"/></Grid><Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="14"><Border Classes="card" Padding="0"><Grid RowDefinitions="Auto,*"><Border Background="#F1F4F9" Padding="13,10" CornerRadius="10,10,0,0"><TextBlock Text="POLICY.YAML · 可编辑" FontSize="9" LetterSpacing=".7" Foreground="{StaticResource SecondaryInk}"/></Border><TextBox Name="DslEditor" Grid.Row="1" Text="{Binding DslText,Mode=TwoWay}" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Menlo,Consolas" FontSize="10" BorderThickness="0" Background="White" Padding="13" VerticalContentAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/></Grid></Border><Border Grid.Column="1" Classes="card" Padding="0"><Grid RowDefinitions="Auto,*"><Border Background="#F1F4F9" Padding="13,10" CornerRadius="10,10,0,0"><TextBlock Text="XRAY.JSON · 生成产物" FontSize="9" LetterSpacing=".7" Foreground="{StaticResource SecondaryInk}"/></Border><TextBox Grid.Row="1" Text="{Binding GeneratedConfig}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Menlo,Consolas" FontSize="10" BorderThickness="0" Background="#FCFDFE" Padding="13" VerticalContentAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/></Grid></Border></Grid></Grid></TabItem>
   <TabItem Header="资源与更新"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="17" Margin="0,19,0,0"><Border Classes="card"><StackPanel Spacing="17"><TextBlock Text="规则源" Classes="section"/><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="6"><TextBlock Text="MetaCubeX 原始 YAML" FontSize="13" FontWeight="Medium"/><TextBlock Text="本地编译 geosite / geoip DAT · 保留匹配语义" Classes="caption"/></StackPanel><Border Grid.Column="1" Background="#EDF7F2" CornerRadius="5" Padding="10,5" VerticalAlignment="Center"><TextBlock Text="{Binding SourceStatusText}" FontSize="10" Foreground="{StaticResource Success}"/></Border></Grid><Border Height="1" Background="#EBEEF4"/><TextBlock Text="修改出口只更新路由；原始集合未变化时复用已编译 DAT。更新失败保留上一份可用文件。" Classes="caption" TextWrapping="Wrap" LineHeight="20"/></StackPanel></Border><Border Classes="card"><StackPanel Spacing="17"><TextBlock Text="客户端与内核" Classes="section"/><TextBlock Text="{Binding ClientBuildLabel}" Classes="caption"/><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="6"><TextBlock Text="Xray-core · 唯一网络内核" FontSize="13" FontWeight="Medium"/><TextBlock Text="资源下载、校验与原子发布由后台模块负责。" Classes="caption"/></StackPanel><Button Grid.Column="1" Content="准备并校验规则" Command="{Binding CompileCommand}"/></Grid><TextBlock TextWrapping="Wrap" Text="{Binding UpdateDescription}" FontSize="10" Foreground="{StaticResource SecondaryInk}"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="日志与诊断"><Grid RowDefinitions="Auto,Auto,*" RowSpacing="15" Margin="0,18,0,0"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="6"><TextBlock Text="当前状态" Classes="section"/><TextBlock Text="{Binding ValidationLabel}" Classes="caption"/></StackPanel><Button Grid.Column="1" Name="LogDirectoryButton" Content="日志目录" Command="{Binding ShowLogDirectoryCommand}"/></Grid><Border Grid.Row="1" Classes="inset"><TextBlock Text="历史事件与当前状态分开。诊断或存储失败不会改变网络保护判断。" FontSize="10" Foreground="{StaticResource SecondaryInk}" TextWrapping="Wrap"/></Border><Border Grid.Row="2" Classes="card" Padding="0"><Grid RowDefinitions="Auto,*"><Border Classes="tableheader"><TextBlock Text="有界保护与生命周期事件" FontSize="10" Foreground="{StaticResource SecondaryInk}"/></Border><ListBox Grid.Row="1" ItemsSource="{Binding Events}" ItemContainerTheme="{StaticResource QuietRow}"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:EventRow"><Grid ColumnDefinitions="42,*" ColumnSpacing="12" Margin="13,14"><TextBlock Text="{Binding Time}" FontSize="10" Foreground="{StaticResource SecondaryInk}" VerticalAlignment="Top"/><StackPanel Grid.Column="1" Spacing="7"><TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium"/><TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource SecondaryInk}" TextWrapping="Wrap" LineHeight="18"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border></Grid></TabItem>
  </TabControl>
  <Border Grid.Row="1" BorderBrush="#E7EBF3" BorderThickness="0,1,0,0" Padding="0,17,0,0"><Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="9"><TextBlock Text="{Binding ValidationLabel}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ValidationLabel}" FontSize="10" Foreground="{StaticResource SecondaryInk}"/><Button Grid.Column="1" Content="校验配置" Command="{Binding CompileCommand}"/><Button Grid.Column="2" Content="{Binding SaveLabel}" Command="{Binding SaveCommand}"/><Button Grid.Column="3" Name="ApplyConfigButton" Content="{Binding ApplyLabel}" Command="{Binding ApplyCommand}" Classes="primary"/></Grid></Border>
 </Grid>
</UserControl>
