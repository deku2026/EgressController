<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:guard="using:EgressController.Guardian" xmlns:ui="using:EgressController.Presentation" x:Class="EgressController.Presentation.GuardPanel" x:DataType="guard:GuardManagementViewModel">
  <ScrollViewer>
    <StackPanel Spacing="18">
      <Border Classes="card">
        <Grid ColumnDefinitions="50,*,Auto" ColumnSpacing="18">
          <Border Background="#E8F3ED" CornerRadius="13" Height="50" Width="50" VerticalAlignment="Top">
            <PathIcon Data="{x:Static ui:Icons.Guardian}" Width="25" Height="25" Foreground="#37805F"/>
          </Border>
          <StackPanel Grid.Column="1" Spacing="7">
            <TextBlock Text="{Binding Summary}" Classes="section-title" TextWrapping="Wrap"/>
            <TextBlock Text="独立运行，只检查主程序存活和 TUN 接管。" Classes="muted"/>
            <TextBlock Text="联网检测由主程序负责。" Classes="muted"/>
          </StackPanel>
          <Border Grid.Column="2" Classes="badge" Classes.healthy="{Binding Healthy}" Classes.waiting="{Binding Red}" VerticalAlignment="Top">
            <TextBlock Text="{Binding StateLabel}" FontSize="12"/>
          </Border>
        </Grid>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="21">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="6">
              <TextBlock Text="开机守护" Classes="section-title"/>
              <TextBlock Text="服务随系统启动，小托盘在登录后出现。" Classes="muted"/>
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoStart}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center" OnContent="开启" OffContent="关闭"/>
          </Grid>
          <Border Background="#E8ECF2" Height="1"/>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="5">
              <TextBlock Text="服务控制" FontWeight="Medium"/>
              <TextBlock Text="手动停止后，本次开机不会自动恢复守护。" Classes="muted"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Content="安装服务" Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}"/>
              <Button Content="启动守护" Classes="primary" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}"/>
              <Button Content="刷新" Command="{Binding RefreshCommand}"/>
            </StackPanel>
          </Grid>
          <WrapPanel>
            <Button Content="停止守护" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}" Margin="0,0,8,0"/>
            <Button Content="停止并关闭自启" Command="{Binding StopAndDisableCommand}" IsEnabled="{Binding CanEdit}" Margin="0,0,8,0"/>
            <Button Content="强制停止" Classes="danger" Command="{Binding ForceStopCommand}" IsEnabled="{Binding CanStop}" Margin="0,0,8,0"/>
            <Button Content="卸载服务" Classes="quiet" Command="{Binding UninstallCommand}" IsEnabled="{Binding CanUninstall}"/>
          </WrapPanel>
          <TextBlock Text="{Binding Message}" Classes="warning" TextWrapping="Wrap" IsVisible="{Binding HasMessage}"/>
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="15">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="5">
              <TextBlock Text="守护记录" Classes="section-title"/>
              <TextBlock Text="最近 24 小时，最多 200 条" Classes="muted"/>
            </StackPanel>
            <Button Grid.Column="1" Content="清空记录" Command="{Binding ClearHistoryCommand}"/>
          </Grid>
          <StackPanel Margin="0,26" Spacing="7" IsVisible="{Binding NoRecords}">
            <TextBlock Text="暂无终止记录" FontSize="16" HorizontalAlignment="Center"/>
            <TextBlock Text="守护触发后的处理结果会显示在这里。" Classes="muted" HorizontalAlignment="Center"/>
          </StackPanel>
          <SelectableTextBlock Text="{Binding Records}" TextWrapping="Wrap" IsVisible="{Binding HasRecords}"/>
        </StackPanel>
      </Border>
      <Border Classes="card">
        <Expander Header="服务信息与日志" HorizontalAlignment="Stretch">
          <StackPanel Spacing="14" Margin="0,12,0,0">
            <SelectableTextBlock Text="{Binding Details}" TextWrapping="Wrap"/>
            <WrapPanel>
              <Button Content="打开服务日志目录" Click="OpenServiceLogs" Margin="0,0,8,0"/>
              <Button Content="打开管理日志目录" Click="OpenManagementLogs"/>
            </WrapPanel>
            <SelectableTextBlock Text="{Binding LogDirectory}" Foreground="#667184" TextWrapping="Wrap"/>
            <TextBlock Text="更换发布包后，需重新安装守护组件。卸载会保留保护名单。" Classes="muted" TextWrapping="Wrap"/>
          </StackPanel>
        </Expander>
      </Border>
      <Border Classes="notice" IsVisible="{Binding HasFailure}">
        <Expander Header="最近操作的错误详情">
          <StackPanel Spacing="10" Margin="0,10,0,0">
            <SelectableTextBlock Text="{Binding LastFailure}" TextWrapping="Wrap"/>
            <SelectableTextBlock Text="{Binding LogFailure}" TextWrapping="Wrap"/>
          </StackPanel>
        </Expander>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
