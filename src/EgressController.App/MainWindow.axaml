<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EgressController.App.ViewModels" xmlns:ui="using:EgressController.Presentation" x:Class="EgressController.App.MainWindow" x:DataType="vm:MainViewModel" Title="EgressController" Width="1440" Height="900" MinWidth="1100" MinHeight="760" RequestedThemeVariant="Light">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:RouteOptionViewModel" x:DataType="vm:RouteOptionViewModel">
      <TextBlock Text="{Binding Label}"/>
    </DataTemplate>
  </Window.DataTemplates>
  <Grid ColumnDefinitions="220,*">
    <Border Background="{StaticResource SidebarBrush}" BorderBrush="#DEE3EC" BorderThickness="0,0,1,0">
      <DockPanel Margin="16,24,16,16">
        <StackPanel DockPanel.Dock="Top" Margin="8,0,0,30" Spacing="5">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="32" Height="32" Background="#5062CE" CornerRadius="9">
              <TextBlock Text="E" FontSize="21" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Egress" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="你的网络，由你选择" Classes="muted" Margin="42,0,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="12">
          <Border Background="#DEE4ED" Height="1" Margin="8,0"/>
          <Button Name="OpenLogsButton" Classes="quiet" Click="OnOpenLogDirectory" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Data="{x:Static ui:Icons.Folder}" Width="17" Height="17"/>
              <TextBlock Text="打开日志目录"/>
            </StackPanel>
          </Button>
          <Border Background="#FFF2DB" CornerRadius="8" Padding="10" IsVisible="{Binding IsPreview}">
            <StackPanel Spacing="4">
              <TextBlock Text="UI 开发模式" Foreground="#8B5D1C" FontWeight="SemiBold"/>
              <TextBlock Text="模拟数据，不连接真实 TUN" FontSize="11" Foreground="#8B5D1C" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="muted" Text="EgressController" Margin="12,0" FontSize="11" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="quiet" Content="退出" Click="OnExitRequested" ToolTip.Tip="退出主程序，独立守护继续运行"/></Grid>
        </StackPanel>
        <ListBox Name="Navigation" Classes="navList" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" SelectionChanged="OnNavigationChanged" ItemContainerTheme="{StaticResource NavigationItem}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavigationItem">
              <Grid ColumnDefinitions="22,*" ColumnSpacing="12">
                <PathIcon Data="{Binding Icon}" Width="17" Height="17"/>
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" VerticalAlignment="Center"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="28,24,28,22" RowDefinitions="Auto,Auto,*">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,22">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding PageTitle}" Classes="page-title"/>
          <TextBlock Text="{Binding PageDescription}" Foreground="#667184"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="0,4,0,0">
          <Border Classes="badge" Classes.healthy="{Binding IsTunRunning}" Classes.waiting="{Binding !IsTunRunning}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Ellipse Classes="state-dot" Classes.active="{Binding IsTunRunning}" Width="6" Height="6"/>
              <TextBlock Text="{Binding TunCaption}" FontSize="12"/>
            </StackPanel>
          </Border>
          <Border Classes="badge" Classes.healthy="{Binding Guard.Healthy}" Classes.waiting="{Binding Guard.Red}">
            <TextBlock Text="{Binding GuardCaption}" FontSize="12"/>
          </Border>
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Background="#FFF1DE" CornerRadius="10" Padding="14,11" Margin="0,0,0,16" IsVisible="{Binding IsProtecting}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="15">
          <StackPanel Spacing="3">
            <TextBlock Text="正在保护所选应用" Foreground="#875515" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Dashboard.StatusDetail}" Foreground="#875515" TextWrapping="Wrap"/>
          </StackPanel>
          <Button Grid.Column="1" Content="查看运行事件" Click="OnShowDiagnostics" VerticalAlignment="Center"/>
        </Grid>
      </Border>
      <ContentControl Name="PageHost" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
  </Grid>
</Window>
