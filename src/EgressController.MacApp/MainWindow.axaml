<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EgressController.MacApp.ViewModels" xmlns:ui="using:EgressController.Presentation" x:Class="EgressController.MacApp.MainWindow" x:DataType="vm:MacMainViewModel" Width="1280" Height="840" MinWidth="1024" MinHeight="680" Title="EgressController" Background="{DynamicResource WorkspaceBrush}" FontFamily="fonts:Inter#Inter" FontSize="13">
  <Grid ColumnDefinitions="204,*">
    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Padding="14,24,14,18">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="8,0,0,28" Spacing="5">
          <StackPanel Orientation="Horizontal" Spacing="10"><Border Background="{DynamicResource AccentBrush}" CornerRadius="9" Width="32" Height="32"><TextBlock Text="E" Foreground="White" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Egress" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
          <TextBlock Text="分流与订阅管理" Classes="muted" FontSize="12" Margin="42,0,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="12">
          <Border Background="{DynamicResource LineBrush}" Height="1" Margin="8,0"/>
          <Button Classes="quiet" Command="{Binding OpenLogsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="10"><PathIcon Data="{x:Static ui:Icons.Folder}" Width="16" Height="16"/><TextBlock Text="打开日志目录"/></StackPanel></Button>
          <Border Background="#FFF2DB" CornerRadius="8" Padding="10" IsVisible="{Binding IsPreview}"><StackPanel Spacing="4"><TextBlock Text="UI 开发模式" Foreground="#8B5D1C" FontWeight="SemiBold"/><TextBlock Text="模拟数据 · 不访问真实网络" FontSize="11" Foreground="#8B5D1C" TextWrapping="Wrap"/></StackPanel></Border>
          <Grid ColumnDefinitions="*,Auto" Margin="8,0"><TextBlock Text="macOS" Classes="muted" FontSize="11"/><TextBlock Grid.Column="1" Text="Surge 后端" Classes="muted" FontSize="11"/></Grid>
        </StackPanel>
        <ListBox Name="Navigation" Classes="navList" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" ItemContainerTheme="{StaticResource NavigationItem}" Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate><DataTemplate x:DataType="vm:NavigationEntry"><Grid ColumnDefinitions="22,*" ColumnSpacing="12"><PathIcon Data="{Binding Icon}" Width="17" Height="17"/><TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="24,24,24,18" RowDefinitions="Auto,*,Auto">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" Margin="0,0,0,20">
        <StackPanel Spacing="7"><TextBlock Text="{Binding SelectedPage.Title}" Classes="page-title"/><TextBlock Text="{Binding SelectedPage.Description}" Classes="muted"/></StackPanel>
        <Border Grid.Column="1" Classes="badge" Classes.healthy="{Binding SurgeConnected}" Classes.waiting="{Binding !SurgeConnected}" VerticalAlignment="Top" Margin="0,4,0,0"><TextBlock Text="{Binding SurgeStatus}" FontSize="12"/></Border>
      </Grid>
      <ContentControl Name="PageHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,14,0,0"><TextBlock Text="{Binding Status}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}"/><TextBlock Grid.Column="1" Text="Surge 负责网络执行" Classes="muted" FontSize="11"/></Grid>
    </Grid>
  </Grid>
</Window>
