<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:EgressController.App.ViewModels"
        xmlns:local="using:EgressController.App"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
        x:Class="EgressController.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="EgressController" Width="1180" Height="760"
        MinWidth="980" MinHeight="620">
    <DockPanel Background="#F6F7FB">
        <Border DockPanel.Dock="Top" Background="#172033" Padding="24,18,24,16">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <StackPanel Grid.Row="0" Spacing="4">
                    <TextBlock Foreground="White" FontSize="25" FontWeight="SemiBold"
                               Text="EgressController" />
                    <TextBlock Foreground="#AAB7CF" FontSize="13"
                               Text="Windows 全流量 TUN · 应用、域名与连接诊断" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="#263652" CornerRadius="14" Padding="12,7">
                        <TextBlock Foreground="#DCE7FF" Text="{Binding Overview.TunBadge}" />
                    </Border>
                    <Button Classes="primary" Command="{Binding Overview.ToggleRoutingCommand}"
                            Content="{Binding Overview.ToggleRoutingText}" />
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,0"
                           Foreground="#C3CDE0" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <TabControl Margin="20" SelectedIndex="0">
            <TabItem Header="概览">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="14">
                            <Border Classes="card" Grid.Row="0" Grid.Column="0">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="eyebrow" Text="ESIM 出口" />
                                    <TextBlock Classes="card-title" Text="{Binding Overview.Esim}" TextWrapping="Wrap" />
                                    <TextBlock Classes="muted" Text="选择实际物理网卡；ifIndex 只在运行时使用。" />
                                    <ComboBox ItemsSource="{Binding Overview.Adapters}"
                                              SelectedItem="{Binding Overview.SelectedAdapter}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AdapterOptionViewModel">
                                                <TextBlock Text="{Binding Display}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                            <Border Classes="card" Grid.Row="0" Grid.Column="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="eyebrow" Text="主网卡" />
                                    <TextBlock Classes="card-title" Text="{Binding Overview.Primary}" TextWrapping="Wrap" />
                                    <TextBlock Classes="muted" Text="主出口用于 upstream SOCKS5 与自身控制连接；绑定名称只在运行时解析。" TextWrapping="Wrap" />
                                    <ComboBox ItemsSource="{Binding Overview.PrimaryAdapters}"
                                              SelectedItem="{Binding Overview.SelectedPrimaryAdapter}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AdapterOptionViewModel">
                                                <TextBlock Text="{Binding Display}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                            <Border Classes="card" Grid.Row="1" Grid.Column="0">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="eyebrow" Text="上游 SOCKS5" />
                                    <TextBlock Classes="card-title" Text="{Binding Overview.Upstream}" />
                                    <TextBlock Classes="muted" Text="未命中应用或 SRS 的流量统一进入这里；软件控制面和上游 owner 通过主网卡，避免递归。" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="Auto,110" ColumnSpacing="8">
                                        <TextBlock Text="SOCKS5 端口" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding Overview.UpstreamPortText, Mode=TwoWay}"
                                                 PlaceholderText="7890" LostFocus="OnUpstreamPortLostFocus"
                                                 KeyDown="OnUpstreamPortKeyDown" />
                                    </Grid>
                                    <Border Classes="metric-pill" HorizontalAlignment="Left">
                                        <TextBlock Text="显式控制面代理 · 使用上方 SOCKS5 端口" />
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Classes="card" Grid.Row="1" Grid.Column="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="eyebrow" Text="sing-box Core" />
                                    <TextBlock Classes="card-title" Text="{Binding Overview.Core}" TextWrapping="Wrap" />
                                     <TextBlock Classes="muted" Text="程序会在 exe 同级 ruleset 中管理 sing-box；配置、状态和日志写入 data。启动时自动尝试开启 TUN。" TextWrapping="Wrap" />
                                    <Button Content="启动 / 应用 TUN" Command="{Binding Overview.StartCommand}"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                            <Border Classes="card" Grid.Row="2" Grid.Column="0">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="eyebrow" Text="TUN 状态" />
                                    <TextBlock Classes="card-title" Text="{Binding Overview.Tun}" />
                                    <TextBlock Classes="muted" Text="{Binding Overview.Traffic}" />
                                    <Button Content="扫描网卡" Command="{Binding Overview.RefreshCommand}"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                            <Border Classes="card" Grid.Row="2" Grid.Column="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="eyebrow" Text="数据面" />
                                     <TextBlock Classes="card-title" Text="{Binding Overview.TunBadge}" />
                                      <TextBlock Classes="muted" Text="仅 sing-box 负责网络数据面；eSIM 不可用时，命中 eSIM 的流量直接拒绝，未命中流量仍走 7890。" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Classes="notice">
                            <TextBlock Text="{Binding Overview.Notice}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="网络与内核">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="14">
                            <Border Classes="card">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="eyebrow" Text="DoH 保护" />
                                    <TextBlock Classes="card-title" Text="{Binding Network.ProtectionStatus}" TextWrapping="Wrap" />
                                    <TextBlock Classes="muted" Text="故障时只拒绝 TUN 外部流量，控制面仍可检测并恢复。" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Classes="card" Grid.Column="1">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="eyebrow" Text="检测状态" />
                                    <TextBlock Classes="card-title" Text="{Binding Network.MonitorStatus}" TextWrapping="Wrap" />
                                    <TextBlock Classes="muted" Text="每 60 秒通过 sing-box Clash API 的 DNS query 检测。" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Classes="card" Grid.Column="2">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="eyebrow" Text="最后检测" />
                                    <TextBlock Classes="card-title" Text="{Binding Network.LastChecked}" TextWrapping="Wrap" />
                                    <TextBlock Classes="muted" Text="每个探测域名只命中对应的 DoH server tag。" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="3" Classes="primary" Content="立即检测"
                                    Command="{Binding Network.CheckCommand}"
                                    VerticalAlignment="Center" />
                        </Grid>
                        <Border Classes="list-card">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="14,12">
                                    <TextBlock Classes="section-title" Text="DoH 配置与连接状态" />
                                    <TextBlock Classes="muted" Text="dns-esim 与 dns-clash 是两个不同出口；Cloudflare/Google 只在各自出口内作为候选。" TextWrapping="Wrap" />
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Network.DohStatuses}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DohEndpointViewModel">
                                                <Border Padding="14,11" BorderBrush="#E6E9F1" BorderThickness="0,0,0,1">
                                                    <Grid ColumnDefinitions="1.1*,1.6*,1.3*,1.2*,Auto" ColumnSpacing="14">
                                                        <StackPanel Spacing="3">
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding RoutePlane}" />
                                                            <TextBlock Classes="tag" Text="{Binding Tag}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="3">
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding Provider}" />
                                                            <TextBlock Classes="muted" Text="{Binding Endpoint}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Classes="muted" Text="{Binding ServerName}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Spacing="3">
                                                            <TextBlock Text="{Binding Detour}" />
                                                            <TextBlock Classes="muted" Text="{Binding Marker}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="3" Text="{Binding Detail}" Classes="muted"
                                                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="4" Text="{Binding State}" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <Border Classes="notice" IsVisible="{Binding Network.HasStatus}">
                            <TextBlock Text="{Binding Network.Status}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Windows 应用">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding Apps.Query}" PlaceholderText="搜索应用或路径…" />
                            <Button Grid.Column="1" Classes="primary" Content="{Binding Apps.ScanText}" Command="{Binding Apps.ScanCommand}" />
                            <Button Grid.Column="2" Content="全选 eSIM" Command="{Binding Apps.SelectAllCommand}" />
                            <Button Grid.Column="3" Content="清空选择" Command="{Binding Apps.ClearAllCommand}" />
                            <TextBlock Grid.Column="4" VerticalAlignment="Center" Classes="muted" Text="{Binding Apps.Summary}" />
                        </Grid>
                        <TextBlock Classes="muted" Text="{Binding Apps.Status}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Classes="list-card" Margin="0,14,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListBox ItemsSource="{Binding Apps.Entries}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AppEntryViewModel">
                                        <Border Padding="8" BorderBrush="#E6E9F1" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="Auto,Auto,*,190" ColumnSpacing="12">
                                                <CheckBox IsChecked="{Binding IsEsim}" IsEnabled="{Binding CanManage}" VerticalAlignment="Center" />
                                                <Border Grid.Column="1" Classes="app-glyph">
                                                    <Grid>
                                                        <Image Source="{Binding Icon}" Width="24" Height="24"
                                                               Stretch="Uniform" IsVisible="{Binding HasIcon}" />
                                                        <TextBlock Text="{Binding Glyph}" IsVisible="{Binding HasNoIcon}" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                    <TextBlock Classes="muted" Text="{Binding Details}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Classes="warning" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Classes="tag" Text="{Binding KindText}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </TabItem>

            <TabItem Header="域名规则">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="10">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                <TextBox Text="{Binding Domains.Query}" PlaceholderText="搜索官方 MetaCubeX geosite，例如 google…" />
                                <Button Grid.Column="1" Classes="primary" Content="{Binding Domains.RefreshText}" Command="{Binding Domains.RefreshCatalogCommand}" />
                            <Button Grid.Column="2" Content="全选当前结果" Command="{Binding Domains.SelectAllCommand}"
                                    IsEnabled="{Binding Domains.CanSelectVisible}" />
                            <Button Grid.Column="3" Content="清空当前结果" Command="{Binding Domains.ClearAllCommand}" />
                            <TextBlock Grid.Column="4" VerticalAlignment="Center" Classes="muted" Text="{Binding Domains.SelectedSummary}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <TextBlock Text="规则来源" VerticalAlignment="Center" Classes="muted" />
                            <TextBlock Grid.Column="1" Text="{Binding Domains.CatalogDirectory}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding Domains.CatalogCommit}" VerticalAlignment="Center" Classes="tag" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding Domains.ManualDomain}" PlaceholderText="添加自定义域名，默认包含根域和所有子域…" />
                            <Button Grid.Column="1" Content="添加到 ESIM" Command="{Binding Domains.AddManualCommand}" />
                        </Grid>
                        <TextBlock Classes="muted" Text="{Binding Domains.Status}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Grid Margin="0,14,0,0" ColumnDefinitions="1.2*,1*" ColumnSpacing="14">
                        <Border Classes="list-card" Grid.Column="0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Classes="section-title" Text="官方 catalog 结果" Margin="14,12" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListBox ItemsSource="{Binding Domains.Results}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RuleEntryViewModel">
                                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,9" ColumnSpacing="10">
                                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                        <TextBlock Classes="muted" Text="{Binding Path}" />
                                                        <TextBlock Classes="success" Text="{Binding Status}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Classes="tag" Text="ESIM" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <Border Classes="list-card" Grid.Column="1">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Classes="section-title" Text="已选择 → ESIM" Margin="14,12" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding Domains.SelectedRules}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RuleEntryViewModel">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,8" ColumnSpacing="8">
                                                        <CheckBox IsChecked="{Binding IsSelected}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Classes="tag" Text="geosite" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Classes="section-title" Text="自定义域名" Margin="14,14,14,6" />
                                        <ItemsControl ItemsSource="{Binding Domains.ManualDomains}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ManualDomainViewModel">
                                                    <Grid ColumnDefinitions="*,Auto" Margin="12,7">
                                                        <TextBlock Text="{Binding Domain}" />
                                                        <Button Grid.Column="1" Content="移除" Command="{Binding RemoveCommand}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="连接">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding Connections.Query}" PlaceholderText="搜索进程、域名、IP、出口或规则…" />
                            <Button Grid.Column="1" Content="{Binding Connections.HistoryToggleText}"
                                    Command="{Binding Connections.ToggleHistoryCommand}" />
                            <Button Grid.Column="2" Content="关闭选中"
                                    Command="{Binding Connections.CloseSelectedCommand}"
                                    IsEnabled="{Binding Connections.CanCloseSelected}" />
                            <Button Grid.Column="3" Content="关闭全部"
                                    Command="{Binding Connections.CloseAllCommand}" />
                            <Button Grid.Column="4" Content="清空历史"
                                    Command="{Binding Connections.ClearHistoryCommand}" />
                            <TextBlock Grid.Column="5" Classes="muted" Text="{Binding Connections.ActiveSummary}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Classes="muted" Text="{Binding Connections.MonitorStatus}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Connections.LastUpdated}" />
                        </Grid>
                        <TextBlock Classes="muted" Text="{Binding Connections.ActionMessage}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Classes="list-card" Margin="0,14,0,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="100,2*,2.2*,90,120,110,110"
                                  ColumnSpacing="10" Margin="12,10">
                                <TextBlock Classes="muted" Text="状态" />
                                <TextBlock Grid.Column="1" Classes="muted" Text="进程" />
                                <TextBlock Grid.Column="2" Classes="muted" Text="目标" />
                                <TextBlock Grid.Column="3" Classes="muted" Text="协议" />
                                <TextBlock Grid.Column="4" Classes="muted" Text="出口" />
                                <TextBlock Grid.Column="5" Classes="muted" Text="速度" />
                                <TextBlock Grid.Column="6" Classes="muted" Text="流量" />
                            </Grid>
                            <ListBox ItemsSource="{Binding Connections.Rows}"
                                     SelectedItem="{Binding Connections.SelectedRow}"
                                     DoubleTapped="OnConnectionDoubleTapped">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ConnectionRowViewModel">
                                        <Border Padding="12,9" BorderBrush="#E6E9F1" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="100,2*,2.2*,90,120,110,110" ColumnSpacing="10">
                                                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding ProcessName}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Classes="muted" Text="{Binding ProcessPath}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Target}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding Protocol}" Classes="tag"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding Route}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="5" Text="{Binding Speed}" Classes="muted"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="6" Text="{Binding Traffic}" Classes="muted"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </TabItem>

            <TabItem Header="流量">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="24">
                            <Grid Width="220" Height="220">
                                <local:QuotaRingControl Percentage="{Binding Traffic.UsedPercent}" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Classes="card-title" Text="{Binding Traffic.UsedPercentText}" />
                                    <TextBlock Classes="muted" Text="套餐占用" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="14" VerticalAlignment="Center">
                                <TextBlock Classes="eyebrow" Text="eSIM 流量套餐" />
                                <Grid ColumnDefinitions="Auto,180" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                                    <TextBlock Text="套餐总量（GB）" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding Traffic.TotalInput, Mode=TwoWay}" />
                                    <TextBlock Grid.Row="1" Text="当前剩余（GB）" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Traffic.RemainingInput, Mode=TwoWay}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Classes="primary" Content="保存并重新统计" Command="{Binding Traffic.SaveQuotaCommand}" />
                                    <Button Content="清空已用流量" Command="{Binding Traffic.ClearUsageCommand}" />
                                </StackPanel>
                                <TextBlock Classes="card-title" Text="{Binding Traffic.Remaining}" />
                                <TextBlock Classes="muted" Text="{Binding Traffic.RemainingPercentText}" />
                                <TextBlock Classes="muted" Text="{Binding Traffic.UsedSummary}" />
                                <TextBlock Classes="warning" Text="{Binding Traffic.Status}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                            <Border Classes="card">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="eyebrow" Text="实时速度" />
                                    <TextBlock Classes="card-title" Text="{Binding Traffic.CurrentRate}" />
                                    <TextBlock Classes="muted" Text="来自 sing-box /traffic WebSocket" />
                                </StackPanel>
                            </Border>
                            <Border Classes="card" Grid.Column="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="eyebrow" Text="活动连接" />
                                    <TextBlock Classes="card-title" Text="{Binding Traffic.Active}" />
                                    <TextBlock Classes="muted" Text="来自连接监控快照" />
                                </StackPanel>
                            </Border>
                            <Border Classes="card" Grid.Column="2">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="eyebrow" Text="统计范围" />
                                    <TextBlock Classes="card-title" Text="仅 eSIM" />
                                    <TextBlock Classes="muted" Text="按连接出口累计上下行" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Classes="notice">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="section-title" Text="监控状态" />
                                <TextBlock Text="{Binding Traffic.MonitorStatus}" />
                                <TextBlock Classes="muted" Text="{Binding Traffic.Note}" TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                    <TextBlock Classes="muted" Text="最后刷新：" />
                                    <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Traffic.LastUpdated}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
