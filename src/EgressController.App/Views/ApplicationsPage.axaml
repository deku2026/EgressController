<local:PageView xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:EgressController.App.Views" xmlns:vm="using:EgressController.App.ViewModels" x:Class="EgressController.App.Views.ApplicationsPage" x:DataType="vm:MainViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="9" Margin="0,0,0,13">
      <TextBox Text="{Binding Apps.Query}" PlaceholderText="搜索应用名称或路径"/>
      <Button Grid.Column="1" Content="{Binding Apps.ScanText}" Command="{Binding Apps.ScanCommand}" Classes="primary"/>
      <Button Grid.Column="2" Content="全选应用" Command="{Binding Apps.SelectAllCommand}"/>
      <Button Grid.Column="3" Content="清空选择" Command="{Binding Apps.ClearAllCommand}"/>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,15">
      <TextBlock Text="{Binding Apps.Status}" Classes="muted" TextWrapping="Wrap"/>
      <TextBlock Grid.Column="1" Text="{Binding Apps.Summary}" Classes="muted"/>
    </Grid>
    <Border Grid.Row="2" Classes="list-card">
      <Grid RowDefinitions="Auto,*,Auto">
        <Border Background="#F9FAFC" BorderBrush="#E6EAF0" BorderThickness="0,0,0,1" Padding="17,12">
          <Grid ColumnDefinitions="32,36,*,75,290" ColumnSpacing="12">
            <TextBlock Grid.Column="2" Text="应用" Classes="muted"/>
            <TextBlock Grid.Column="3" Text="程序清单" Classes="muted"/>
            <TextBlock Grid.Column="4" Text="分流出口" Classes="muted"/>
          </Grid>
        </Border>
        <ListBox Grid.Row="1" Classes="table" ItemsSource="{Binding Apps.Entries}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AppEntryViewModel">
              <Border BorderBrush="#EDF0F5" BorderThickness="0,0,0,1" Padding="17,13">
                <Grid ColumnDefinitions="32,36,*,75,290" ColumnSpacing="12" IsEnabled="{Binding CanManage}">
                  <CheckBox IsChecked="{Binding Routing.IsSelected}" IsEnabled="{Binding Routing.CanEdit}" VerticalAlignment="Center"/>
                  <Border Grid.Column="1" Classes="app-glyph" VerticalAlignment="Center">
                    <Grid>
                      <Image Source="{Binding Icon}" Width="25" Height="25" IsVisible="{Binding HasIcon}"/>
                      <TextBlock Text="{Binding Initial}" IsVisible="{Binding HasNoIcon}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Foreground="#5365C4"/>
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium"/>
                    <TextBlock Text="{Binding Command}" Classes="muted" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Details}"/>
                    <TextBlock Text="{Binding Routing.Status}" Classes="warning" IsVisible="{Binding Routing.HasStatus}" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <TextBlock Grid.Column="3" Text="{Binding InventorySummary}" ToolTip.Tip="{Binding InventoryDetails}" Classes="muted" VerticalAlignment="Center"/>
                  <Grid Grid.Column="4" ColumnDefinitions="75,*" ColumnSpacing="8" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Routing.Kinds}" SelectedItem="{Binding Routing.SelectedKind}" IsEnabled="{Binding Routing.CanEdit}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Routing.VisibleOptions}" SelectedItem="{Binding Routing.SelectedRoute}" IsEnabled="{Binding Routing.CanEdit}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Apps.IsEmpty}">
          <TextBlock Text="没有找到应用" FontSize="18" FontWeight="Medium"/>
          <TextBlock Text="重新扫描，或调整搜索内容。" Classes="muted"/>
        </StackPanel>
        <Border Grid.Row="2" BorderBrush="#E8EDF4" BorderThickness="0,1,0,0" Padding="17,12">
          <TextBlock Text="勾选后保护已保存的 EXE 路径。选择出口立即应用，恢复后请手动重新打开应用。" Classes="muted" TextWrapping="Wrap"/>
        </Border>
      </Grid>
    </Border>
  </Grid>
</local:PageView>
