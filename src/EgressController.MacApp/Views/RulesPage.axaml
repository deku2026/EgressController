<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EgressController.MacApp.ViewModels" x:Class="EgressController.MacApp.Views.RulesPage" x:DataType="vm:MacMainViewModel">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">
    <Border Classes="card" Padding="18"><StackPanel Spacing="12"><TextBlock Text="自定义域名" Classes="card-title"/><Grid ColumnDefinitions="*,220,Auto" ColumnSpacing="10"><TextBox Text="{Binding NewDomain}" PlaceholderText="例如 anthropic.com"/><ComboBox Grid.Column="1" ItemsSource="{Binding RouteOptions}" SelectedItem="{Binding NewDomainRoute}" HorizontalAlignment="Stretch"/><Button Grid.Column="2" Content="添加" Command="{Binding AddDomainCommand}"/></Grid><ItemsControl ItemsSource="{Binding Domains}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:DomainRow"><Grid ColumnDefinitions="*,180,Auto" ColumnSpacing="10" Margin="0,6"><TextBlock Text="{Binding Domain}"/><TextBlock Grid.Column="1" Text="{Binding RouteLabel}" Classes="muted"/><Button Grid.Column="2" Content="移除" Command="{Binding $parent[UserControl].((vm:MacMainViewModel)DataContext).RemoveDomainCommand}" CommandParameter="{Binding}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8"><TextBox Text="{Binding RuleSearch}" PlaceholderText="搜索 blackmatrix7 Surge 规则集"/><Button Grid.Column="1" Content="全选结果" Command="{Binding SelectVisibleRulesCommand}"/><Button Grid.Column="2" Content="取消选择" Command="{Binding ClearVisibleRulesCommand}"/><Button Grid.Column="3" Content="更新目录" Command="{Binding RefreshRulesCommand}" IsEnabled="{Binding !Busy}"/></Grid>
    <Border Grid.Row="2" Classes="list-card" Padding="12"><Grid RowDefinitions="Auto,*,Auto"><Grid ColumnDefinitions="36,*,220" Margin="8,5,8,12" ColumnSpacing="12"><TextBlock Grid.Column="1" Text="Surge 规则集" Classes="muted" FontSize="12"/><TextBlock Grid.Column="2" Text="出口" Classes="muted" FontSize="12"/></Grid><ListBox Grid.Row="1" ItemsSource="{Binding VisibleRules}" ItemContainerTheme="{StaticResource TableRow}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:RuleRow"><Grid ColumnDefinitions="28,*,220" ColumnSpacing="12" Margin="8,10"><CheckBox IsChecked="{Binding Selected}"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Name}" FontWeight="Medium"/><TextBlock Text="blackmatrix7 / Surge" Classes="muted" FontSize="11"/></StackPanel><ComboBox Grid.Column="2" ItemsSource="{Binding Routes}" SelectedItem="{Binding Route}" HorizontalAlignment="Stretch" IsEnabled="{Binding Selected}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Grid.Row="2" Text="输出 RULE-SET 引用；目录更新失败保留有效缓存与已选规则。" Classes="muted" FontSize="12" Margin="8,12,8,0"/></Grid></Border>
  </Grid>
</UserControl>
