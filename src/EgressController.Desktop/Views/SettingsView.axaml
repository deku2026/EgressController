<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EgressController.Desktop.ViewModels" xmlns:ui="using:EgressController.Desktop.Presentation.Controls" x:Class="EgressController.Desktop.Views.SettingsView" x:DataType="vm:ShellViewModel">
 <Grid RowDefinitions="*,Auto" RowSpacing="17">
  <TabControl Name="SettingsTabs" SelectedIndex="{Binding SettingsTab,Mode=TwoWay}">
   <TabItem Header="网络与 TUN"><ScrollViewer><StackPanel Spacing="17" Margin="0,19,0,0">
    <Border Classes="card"><StackPanel Spacing="19"><StackPanel Spacing="6"><TextBlock Text="物理出口" Classes="section"/><TextBlock Text="使用稳定接口身份保存选择，网卡名称变化不会改变策略。" Classes="caption"/></StackPanel><Grid ColumnDefinitions="*,*" ColumnSpacing="24"><StackPanel Spacing="10"><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Fill="{StaticResource Home}" Width="6" Height="6"/><TextBlock Text="家宽网卡" FontSize="12"/></StackPanel><ComboBox Name="HomeInterfaceBox" ItemsSource="{Binding InterfaceChoices}" SelectedItem="{Binding SelectedHomeInterface,Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:Choice"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="物理出口 A · 仅供显式家宽策略使用" FontSize="10" Foreground="#A294B8"/></StackPanel><StackPanel Grid.Column="1" Spacing="10"><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Fill="{StaticResource NonHome}" Width="6" Height="6"/><TextBlock Text="非家宽网卡" FontSize="12"/></StackPanel><ComboBox Name="NonHomeInterfaceBox" ItemsSource="{Binding InterfaceChoices}" SelectedItem="{Binding SelectedNonHomeInterface,Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:Choice"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="物理出口 B · 国内默认与代理节点连接" FontSize="10" Foreground="#88ABB1"/></StackPanel></Grid><Border Height="1" Background="#EBEEF4"/><TextBlock Text="出口不可用时连接失败，禁止回退到另一张网卡。" FontSize="11" Foreground="#8E9AAE"/></StackPanel></Border>
    <Border Classes="card"><Grid ColumnDefinitions="35,*,Auto" ColumnSpacing="13"><ui:Glyph Kind="shield" Width="29" Height="29" Foreground="#8A9FBE"/><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="Xray 原生 TUN" Classes="section"/><TextBlock Text="仅在授权后由特权服务管理 DNS、路由与网络恢复。" Classes="caption"/><TextBlock Text="当前是隔离预览，系统网络与管理员权限均未使用。" FontSize="10" Foreground="#A18C68"/></StackPanel><Border Grid.Column="2" Background="#F2F5FA" CornerRadius="5" Padding="9,5" VerticalAlignment="Top"><TextBlock Text="未接管系统" FontSize="10" Foreground="#92A0B3"/></Border></Grid></Border>
    <Button Content="重新体验首次设置" Command="{Binding BeginSetupCommand}" HorizontalAlignment="Left"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="DNS"><ScrollViewer><StackPanel Spacing="18" Margin="0,19,0,0"><Border Classes="card"><StackPanel Spacing="19"><StackPanel Spacing="6"><TextBlock Text="真实 IP 解析" Classes="section"/><TextBlock Text="不默认使用 Fake-IP，域名与 IP 规则共同完成匹配。" Classes="caption"/></StackPanel><Grid ColumnDefinitions="150,*" ColumnSpacing="24"><TextBlock Text="DNS 上游 IP" FontSize="12"/><TextBox Text="{Binding DnsServer,Mode=TwoWay}" Width="280" HorizontalAlignment="Left" AutomationProperties.Name="DNS上游IP"/></Grid><Border Height="1" Background="#EBEEF4"/><StackPanel Spacing="11"><TextBlock Text="常规 DNS → TUN → Xray DNS outbound" FontSize="12" FontWeight="Medium"/><TextBlock Text="域名嗅探辅助 HTTP、TLS 与 QUIC。应用自带加密 DNS、ECH 或纯 IP 连接仍由 IP 集合兜底。" Classes="caption" TextWrapping="Wrap" LineHeight="20"/></StackPanel></StackPanel></Border><Border Classes="inset"><TextBlock Text="系统 DNS 的备份与恢复属于特权服务；预览只编译 DNS 设置，不修改本机 DNS。" FontSize="10" Foreground="#8D9AB0" TextWrapping="Wrap"/></Border></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="DSL 配置"><Grid RowDefinitions="Auto,*" RowSpacing="13" Margin="0,18,0,0"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><StackPanel Spacing="5"><TextBlock Text="一份配置，统一所有策略" Classes="section"/><TextBlock Text="编辑 YAML，校验通过后同步到界面与 Xray 生成配置。" Classes="caption" FontSize="10"/></StackPanel><Button Grid.Column="1" Content="从界面重置" Command="{Binding ResetDslCommand}"/><Button Grid.Column="2" Content="校验并同步" Command="{Binding ApplyDslCommand}"/></Grid><Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="14"><Border Classes="card" Padding="0"><Grid RowDefinitions="Auto,*"><Border Background="#F1F4F9" Padding="13,10" CornerRadius="10,10,0,0"><TextBlock Text="POLICY.YAML · 可编辑" FontSize="9" LetterSpacing=".7" Foreground="#8998AF"/></Border><TextBox Name="DslEditor" Grid.Row="1" Text="{Binding DslText,Mode=TwoWay}" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Menlo,Consolas" FontSize="10" BorderThickness="0" Background="White" Padding="13" VerticalContentAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/></Grid></Border><Border Grid.Column="1" Classes="card" Padding="0"><Grid RowDefinitions="Auto,*"><Border Background="#F1F4F9" Padding="13,10" CornerRadius="10,10,0,0"><TextBlock Text="XRAY.JSON · 生成产物" FontSize="9" LetterSpacing=".7" Foreground="#8998AF"/></Border><TextBox Grid.Row="1" Text="{Binding GeneratedConfig}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Menlo,Consolas" FontSize="10" BorderThickness="0" Background="#FCFDFE" Padding="13" VerticalContentAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/></Grid></Border></Grid></Grid></TabItem>
   <TabItem Header="资源与更新"><ScrollViewer><StackPanel Spacing="17" Margin="0,19,0,0"><Border Classes="card"><StackPanel Spacing="17"><TextBlock Text="规则源" Classes="section"/><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="6"><TextBlock Text="MetaCubeX 原始 YAML" FontSize="13" FontWeight="Medium"/><TextBlock Text="本地编译 geosite / geoip DAT · 保留匹配语义" Classes="caption"/></StackPanel><Border Grid.Column="1" Background="#EDF7F2" CornerRadius="5" Padding="10,5" VerticalAlignment="Center"><TextBlock Text="本地示例缓存" FontSize="10" Foreground="#71A18B"/></Border></Grid><Border Height="1" Background="#EBEEF4"/><TextBlock Text="修改出口只更新路由；原始集合未变化时复用已编译 DAT。更新失败保留上一份可用文件。" Classes="caption" TextWrapping="Wrap" LineHeight="20"/></StackPanel></Border><Border Classes="card"><StackPanel Spacing="17"><TextBlock Text="客户端与内核" Classes="section"/><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="6"><TextBlock Text="Xray-core · 唯一网络内核" FontSize="13" FontWeight="Medium"/><TextBlock Text="资源下载、校验与原子发布由后台模块负责。" Classes="caption"/></StackPanel><Button Grid.Column="1" Content="实时更新未开放" IsEnabled="False"/></Grid><TextBlock Text="本次预览不下载或执行真实内核，不检查远程发布源。" FontSize="10" Foreground="#9BA7B8"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="日志与诊断"><Grid RowDefinitions="Auto,Auto,*" RowSpacing="15" Margin="0,18,0,0"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="6"><TextBlock Text="当前状态" Classes="section"/><TextBlock Text="{Binding ValidationLabel}" Classes="caption"/></StackPanel><Button Grid.Column="1" Name="LogDirectoryButton" Content="日志目录" Command="{Binding ShowLogDirectoryCommand}"/></Grid><Border Grid.Row="1" Classes="inset"><TextBlock Text="历史事件与当前状态分开。诊断或存储失败不会改变网络保护判断。" FontSize="10" Foreground="#8795AC" TextWrapping="Wrap"/></Border><Border Grid.Row="2" Classes="card" Padding="0"><Grid RowDefinitions="Auto,*"><Border Classes="tableheader"><TextBlock Text="当前隔离会话 · 有界事件历史" FontSize="10" Foreground="#8B98AF"/></Border><ListBox Grid.Row="1" ItemsSource="{Binding Events}" ItemContainerTheme="{StaticResource QuietRow}"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:EventRow"><Grid ColumnDefinitions="42,*" ColumnSpacing="12" Margin="13,14"><TextBlock Text="{Binding Time}" FontSize="10" Foreground="#A0AABD" VerticalAlignment="Top"/><StackPanel Grid.Column="1" Spacing="7"><TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium"/><TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#94A0B4" TextWrapping="Wrap" LineHeight="18"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border></Grid></TabItem>
  </TabControl>
  <Border Grid.Row="1" BorderBrush="#E7EBF3" BorderThickness="0,1,0,0" Padding="0,17,0,0"><Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="9"><TextBlock Text="{Binding ValidationLabel}" FontSize="10" Foreground="#8A9BB2"/><Button Grid.Column="1" Content="校验配置" Command="{Binding CompileCommand}"/><Button Grid.Column="2" Content="保存预览草稿" Command="{Binding SaveCommand}"/><Button Grid.Column="3" Name="ApplyConfigButton" Content="应用到模拟环境" Command="{Binding ApplyCommand}" Classes="primary"/></Grid></Border>
 </Grid>
</UserControl>
