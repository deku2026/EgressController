<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EgressController.MacApp.ViewModels" x:Class="EgressController.MacApp.Views.NetworkPage" x:DataType="vm:MacMainViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="16">
    <Border Classes="card" Padding="20"><StackPanel Spacing="16"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="物理网卡" Classes="card-title"/><Button Grid.Column="1" Content="刷新网卡" Command="{Binding RefreshAdaptersCommand}" IsEnabled="{Binding !Busy}"/></Grid>
      <ItemsControl ItemsSource="{Binding Adapters}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:AdapterRow"><Grid ColumnDefinitions="32,*,2*,Auto" ColumnSpacing="12" Margin="0,6"><CheckBox IsChecked="{Binding Selected}"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Name}" FontWeight="Medium"/><TextBlock Text="{Binding Id}" FontSize="11" Classes="muted"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="muted" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding Status}" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Border Height="1" Background="{DynamicResource LineBrush}"/><Grid ColumnDefinitions="150,*" ColumnSpacing="14"><TextBlock Text="默认分流出口" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding RouteOptions}" SelectedItem="{Binding DefaultRoute}" HorizontalAlignment="Stretch"/></Grid>
    </StackPanel></Border>
    <Border Classes="card" Padding="20"><StackPanel Spacing="16">
      <StackPanel Spacing="5"><TextBlock Text="本地 SOCKS5" Classes="card-title"/><TextBlock Text="先检测监听与握手，再核对真实代理核心路径和物理出口。" Classes="muted" FontSize="12"/></StackPanel>
      <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="12"><TextBox Text="{Binding NewPort}" PlaceholderText="端口"/><ComboBox Grid.Column="1" ItemsSource="{Binding Adapters}" SelectedItem="{Binding ProxyAdapter}" PlaceholderText="代理核心的物理出口" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:AdapterRow"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Grid.Column="2" Content="检测并添加" Command="{Binding AddPortCommand}" IsEnabled="{Binding !Busy}"/></Grid>
      <ItemsControl ItemsSource="{Binding Ports}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PortRow"><Border Background="#F7F9FC" CornerRadius="8" Padding="14" Margin="0,0,0,8"><StackPanel Spacing="7"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Address}" FontWeight="SemiBold"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"><TextBlock Text="{Binding Status}" Classes="muted" FontSize="12" VerticalAlignment="Center"/><Button Content="移除" Command="{Binding $parent[UserControl].((vm:MacMainViewModel)DataContext).RemovePortCommand}" CommandParameter="{Binding}"/></StackPanel></Grid><TextBlock Text="{Binding Owner}" FontSize="12" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Grid ColumnDefinitions="150,*" ColumnSpacing="14"><TextBlock Text="资源下载默认端口" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding Ports}" SelectedItem="{Binding DownloadPort}" PlaceholderText="选择已添加的端口" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PortRow"><TextBlock Text="{Binding Address}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
      <TextBlock Text="规则目录与规则资源通过所选 SOCKS5 下载。外部代理软件自行运行，关闭它自身的 TUN。" Classes="muted" TextWrapping="Wrap" FontSize="12"/>
    </StackPanel></Border>
    <Border Classes="card" Padding="20"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="6"><TextBlock Text="机场节点" Classes="card-title"/><TextBlock Text="{Binding SubscriptionNodesStatus}" Classes="muted"/><TextBlock Text="获取并校验 Surge 订阅后，读取节点即可在应用和域名出口中选择。" Classes="muted" FontSize="12" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="读取最新节点" Command="{Binding ReloadSubscriptionNodesCommand}" IsEnabled="{Binding !Busy}"/></Grid></Border>
  </StackPanel></ScrollViewer>
</UserControl>
