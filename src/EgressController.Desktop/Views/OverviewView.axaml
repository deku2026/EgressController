<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EgressController.Desktop.ViewModels" xmlns:ui="using:EgressController.Desktop.Presentation.Controls" xmlns:views="using:EgressController.Desktop.Views" x:Class="EgressController.Desktop.Views.OverviewView" x:DataType="vm:ShellViewModel">
 <Grid RowDefinitions="Auto,*" RowSpacing="17">
  <Border Background="#EDF1F7" CornerRadius="7" Padding="3" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="2"><Button Name="OverviewSummaryTab" Classes="route" Classes.active="{Binding Connections.SummaryVisible}" Content="网络概览" Command="{Binding Connections.ShowSummaryCommand}" Padding="14,5"/><Button Name="OverviewConnectionsTab" Classes="route" Classes.active="{Binding Connections.IsOpen}" Content="连接活动" Command="{Binding Connections.ShowConnectionsCommand}" Padding="14,5"/></StackPanel></Border>
 <Grid Grid.Row="1" IsVisible="{Binding Connections.IsOpen}"><views:ConnectionWorkspaceView DataContext="{Binding Connections}"/></Grid>
 <ScrollViewer Grid.Row="1" IsVisible="{Binding Connections.SummaryVisible}" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Spacing="18">
   <Border Classes="card" Padding="19,17"><Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="14"><Border Background="{Binding StatusSurfaceBrush}" CornerRadius="11" Width="42" Height="42"><ui:Glyph Kind="shield" Foreground="{Binding StatusIconBrush}" Width="25" Height="25"/></Border><StackPanel Grid.Column="1" Spacing="5"><StackPanel Orientation="Horizontal" Spacing="9"><TextBlock Text="{Binding StatusTitle}" FontSize="17" FontWeight="SemiBold"/><Border Background="{Binding StatusSurfaceBrush}" CornerRadius="4" Padding="6,3"><TextBlock Text="{Binding RuntimeBadge}" Foreground="{Binding StatusIconBrush}" FontSize="8" FontWeight="SemiBold" LetterSpacing=".8"/></Border></StackPanel><TextBlock Text="{Binding StatusDescription}" Classes="muted"/></StackPanel><Button Grid.Column="2" Content="{Binding TogglePreviewLabel}" Command="{Binding TogglePreviewCommand}" VerticalAlignment="Center"/></Grid></Border>
   <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
    <Border Classes="card" Name="HomeExitCard" Padding="18,17"><StackPanel Spacing="15"><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Fill="{StaticResource Home}" Width="6" Height="6"/><TextBlock Text="家宽直连" FontWeight="Medium" FontSize="12"/></StackPanel><ui:Glyph Grid.Column="1" Kind="network" Foreground="#AC9ACA" Width="18" Height="18"/></Grid><StackPanel Spacing="5"><TextBlock Text="{Binding HomeInterfaceName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding HomeInterfaceName}"/><TextBlock Text="物理出口 A · 严格绑定" FontSize="10" Foreground="{StaticResource HomeInk}"/></StackPanel><Border Background="#F5F0FC" CornerRadius="5" Padding="8,5"><TextBlock Text="为需要家宽环境的应用保留" FontSize="10" Foreground="{StaticResource HomeInk}"/></Border></StackPanel></Border>
    <Border Grid.Column="1" Classes="card" Padding="18,17"><StackPanel Spacing="15"><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Fill="{StaticResource NonHome}" Width="6" Height="6"/><TextBlock Text="非家宽直连" FontWeight="Medium" FontSize="12"/></StackPanel><ui:Glyph Grid.Column="1" Kind="network" Foreground="#80B8C0" Width="18" Height="18"/></Grid><StackPanel Spacing="5"><TextBlock Text="{Binding NonHomeInterfaceName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding NonHomeInterfaceName}"/><TextBlock Text="物理出口 B · 严格绑定" FontSize="10" Foreground="{StaticResource NonHomeInk}"/></StackPanel><Border Background="#EDF8F9" CornerRadius="5" Padding="8,5"><TextBlock Text="中国大陆默认使用此出口" FontSize="10" Foreground="{StaticResource NonHomeInk}"/></Border></StackPanel></Border>
    <Border Grid.Column="2" Classes="card" Padding="18,17"><StackPanel Spacing="14"><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Fill="{StaticResource Proxy}" Width="6" Height="6"/><TextBlock Text="全局代理" FontWeight="Medium" FontSize="12"/></StackPanel><ui:Glyph Grid.Column="1" Kind="globe" Foreground="#8BA7D5" Width="18" Height="18"/></Grid><StackPanel Spacing="5"><TextBlock Text="{Binding GlobalTargetName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding GlobalTargetName}"/><TextBlock Text="{Binding ProxyResolvedName}" FontSize="10" Foreground="{StaticResource ProxyInk}"/></StackPanel><Border Background="#EEF4FF" CornerRadius="5" Padding="8,5"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="经非家宽 · 全球兜底" FontSize="10" Foreground="{StaticResource ProxyInk}"/><Button Grid.Column="1" Content="管理" Classes="link" FontSize="10" MinHeight="12" Padding="0" Command="{Binding NodesCommand}"/></Grid></Border></StackPanel></Border>
   </Grid>
   <Grid ColumnDefinitions="*,250" ColumnSpacing="18">
    <Border Classes="card" Padding="20,18,20,12"><StackPanel Spacing="10"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="连接脉搏" Classes="section"/><TextBlock Text="{Binding ObservationDescription}" Classes="caption" FontSize="9.5"/></StackPanel><TextBlock Grid.Column="1" IsVisible="{Binding HasObservations}" Text="MiB/s" FontSize="10" Foreground="{StaticResource SecondaryInk}" VerticalAlignment="Top"/></Grid><ui:ObservationChart IsVisible="{Binding HasObservations}" Samples="{Binding Observations}" Height="133"/><TextBlock IsVisible="{Binding !HasObservations}" Text="{Binding NoObservationsText}" Height="133" FontSize="11" Foreground="{StaticResource SecondaryInk}" TextWrapping="Wrap" VerticalAlignment="Center"/><StackPanel IsVisible="{Binding HasObservations}" Orientation="Horizontal" Spacing="15" Margin="32,0,0,0"><StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="5" Height="5" Fill="#5D8FE5"/><TextBlock Text="下载" FontSize="10" Foreground="{StaticResource SecondaryInk}"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="5" Height="5" Fill="#A08BD5"/><TextBlock Text="上传" FontSize="10" Foreground="{StaticResource SecondaryInk}"/></StackPanel><TextBlock Text="共享刻度 0–8 MiB/s" FontSize="9" Foreground="{StaticResource SecondaryInk}"/></StackPanel></StackPanel></Border>
    <Border Classes="card" Grid.Column="1" Padding="18"><StackPanel Spacing="16"><TextBlock Text="策略顺序" Classes="section"/><StackPanel Spacing="13"><Grid ColumnDefinitions="18,*" ColumnSpacing="8"><TextBlock Text="01" FontSize="10" Foreground="{StaticResource SecondaryInk}"/><TextBlock Grid.Column="1" Text="应用的专属出口" FontSize="11"/></Grid><Grid ColumnDefinitions="18,*" ColumnSpacing="8"><TextBlock Text="02" FontSize="10" Foreground="{StaticResource SecondaryInk}"/><TextBlock Grid.Column="1" Text="域名与 IP 规则集合" FontSize="11"/></Grid><Grid ColumnDefinitions="18,*" ColumnSpacing="8"><TextBlock Text="03" FontSize="10" Foreground="{StaticResource SecondaryInk}"/><TextBlock Grid.Column="1" Text="中国大陆 → 非家宽" FontSize="11"/></Grid><Grid ColumnDefinitions="18,*" ColumnSpacing="8"><TextBlock Text="04" FontSize="10" Foreground="{StaticResource SecondaryInk}"/><TextBlock Grid.Column="1" Text="其他流量 → 全局代理" FontSize="11"/></Grid></StackPanel><Border Height="1" Background="#EBEEF4"/><TextBlock Text="指定出口不可用时连接失败，&#10;不自动切换到其他网卡。" FontSize="10" Foreground="{StaticResource SecondaryInk}" LineHeight="17"/></StackPanel></Border>
   </Grid>
   <Border Classes="card" Padding="0"><Grid RowDefinitions="Auto,Auto"><Grid Margin="19,15" ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="常用应用" Classes="section"/><TextBlock Text="{Binding ApplicationCountLabel}" Classes="caption" FontSize="10"/></StackPanel><Button Grid.Column="1" Classes="link" Content="管理全部应用 →" Command="{Binding AppsCommand}" FontSize="11"/></Grid><ItemsControl Grid.Row="1" ItemsSource="{Binding OverviewApps}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:AppRow"><Border BorderBrush="#F0F2F7" BorderThickness="0,1,0,0" Padding="19,11"><Grid ColumnDefinitions="34,*,265" ColumnSpacing="11"><ui:ProductAvatar Source="{Binding Icon}" Product="{Binding Product}" Width="32" Height="32"/><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/><TextBlock Text="{Binding Subtitle}" Classes="caption" FontSize="9.5"/></StackPanel><ui:RoutePicker Grid.Column="2" SelectedIndex="{Binding RouteIndex,Mode=TwoWay}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Border>
   <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2"><StackPanel Orientation="Horizontal" Spacing="7"><ui:Glyph Kind="shield" Width="14" Height="14" Foreground="#A0ACBE"/><TextBlock Text="{Binding WorkspaceSafetyText}" FontSize="10" Foreground="{StaticResource SecondaryInk}"/></StackPanel><Button Grid.Column="1" Content="重新体验首次设置" Command="{Binding BeginSetupCommand}" Classes="link" FontSize="10"/></Grid>
  </StackPanel>
 </ScrollViewer>
 </Grid>
</UserControl>
