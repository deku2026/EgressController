<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EgressController.App.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Border.card">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E4E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style Selector="Border.list-card">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E4E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="Border.notice">
            <Setter Property="Background" Value="#EEF4FF" />
            <Setter Property="BorderBrush" Value="#D5E2FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#68758C" />
        </Style>
        <Style Selector="TextBlock.card-title">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#172033" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#6B7588" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.warning">
            <Setter Property="Foreground" Value="#A26400" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.success">
            <Setter Property="Foreground" Value="#27734B" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.tag">
            <Setter Property="Foreground" Value="#3657A7" />
            <Setter Property="Background" Value="#EDF2FF" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#172033" />
        </Style>
        <Style Selector="TextBlock.table-head">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#667188" />
        </Style>
        <Style Selector="Border.metric-pill">
            <Setter Property="Background" Value="#EAF8F0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="9,5" />
        </Style>
        <Style Selector="Border.app-glyph">
            <Setter Property="Background" Value="#EEF2FA" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="7" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#4361D7" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Application.Styles>
</Application>
