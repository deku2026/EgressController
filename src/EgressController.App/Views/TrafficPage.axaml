<local:PageView xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:EgressController.App.Views" xmlns:vm="using:EgressController.App.ViewModels" xmlns:ui="using:EgressController.Presentation" x:Class="EgressController.App.Views.TrafficPage" x:DataType="vm:MainViewModel">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">
      <Grid ColumnDefinitions=".8*,1.2*" ColumnSpacing="16">
        <Border Classes="card">
          <StackPanel Spacing="18">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="近 30 天用量" Classes="section-title"/><TextBlock Grid.Column="1" Text="{Binding Traffic.Period}" Classes="muted" VerticalAlignment="Center"/></Grid>
            <TextBlock Text="{Binding Traffic.Total}" Classes="metric number" FontSize="36"/>
            <Grid ColumnDefinitions="*,1,*" ColumnSpacing="20">
              <StackPanel Spacing="6"><TextBlock Text="家宽" Classes="home"/><TextBlock Text="{Binding Traffic.Home}" Classes="secondary-metric" FontSize="20"/></StackPanel>
              <Border Grid.Column="1" Classes="divider"/>
              <StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="非家宽" Classes="other"/><TextBlock Text="{Binding Traffic.Other}" Classes="secondary-metric" FontSize="20"/></StackPanel>
            </Grid>
            <ui:UsageBar Home="{Binding Traffic.HomeBytes}" Other="{Binding Traffic.OtherBytes}" Unknown="{Binding Traffic.UnknownBytes}" Maximum="{Binding Traffic.TotalBytes}" Height="14"/>
            <TextBlock Text="{Binding Traffic.Unknown, StringFormat='未识别出口 {0}'}" Classes="muted" IsVisible="{Binding Traffic.HasUnknown}"/>
            <TextBlock Text="{Binding Traffic.RecordedSince}" Classes="muted" FontSize="11.5"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="card">
          <Grid RowDefinitions="Auto,*" RowSpacing="16">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="每日用量" Classes="section-title"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14"><TextBlock Text="家宽" Classes="home"/><TextBlock Text="非家宽" Classes="other"/></StackPanel></Grid>
            <ui:DailyTrafficChart Grid.Row="1" Days="{Binding Traffic.Days}" MinHeight="180"/>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Row="1" Classes="notice" IsVisible="{Binding Traffic.HasError}"><TextBlock Text="{Binding Traffic.Status}" Classes="warning" TextWrapping="Wrap"/></Border>
      <Border Grid.Row="2" Classes="card" Padding="20,16">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
          <Grid ColumnDefinitions="*,Auto,280" ColumnSpacing="18">
            <TextBlock Text="应用用量" Classes="section-title" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding Traffic.ApplicationCount}" Classes="muted" VerticalAlignment="Center"/>
            <TextBox Grid.Column="2" Text="{Binding Traffic.Query}" PlaceholderText="筛选应用" AutomationProperties.Name="筛选应用流量"/>
          </Grid>
          <local:ApplicationTrafficList Grid.Row="1" ItemsSource="{Binding Traffic.Applications}"/>
          <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="8" IsVisible="{Binding Traffic.IsEmpty}"><TextBlock Text="暂无匹配的用量记录" HorizontalAlignment="Center" FontSize="16"/><TextBlock Text="开始联网，或调整搜索内容。" Classes="muted" HorizontalAlignment="Center"/></StackPanel>
          <TextBlock Grid.Row="2" Text="累计本机观测到的连接流量；不补算主程序未运行期间的数据。" Classes="muted" FontSize="11.5" TextWrapping="Wrap"/>
        </Grid>
      </Border>
  </Grid>
</local:PageView>
