<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EgressController.Desktop.ViewModels" xmlns:views="using:EgressController.Desktop.Views" xmlns:ui="using:EgressController.Desktop.Presentation.Controls" x:Class="EgressController.Desktop.Views.SetupOverlay" x:DataType="vm:ShellViewModel">
 <Border Background="#70303B50" Padding="25"><Border Background="#FCFDFE" BorderBrush="#DDE5F0" BorderThickness="1" CornerRadius="17" Width="610" MaxHeight="660" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 16 60 0 #30394A70"><Grid RowDefinitions="Auto,*,Auto">
  <Grid Margin="28,23,25,0" ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8"><Border Background="#EAF0FC" Width="27" Height="27" CornerRadius="7"><ui:Glyph Kind="arrow" Width="18" Height="18" Foreground="#6D8BC1"/></Border><TextBlock Text="让网络各行其道" FontSize="12" FontWeight="Medium" Foreground="#8495AE"/><TextBlock IsVisible="{Binding IsPreview}" Text="PREVIEW" FontSize="8" Foreground="#B6A178" LetterSpacing="1"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5"><Button IsVisible="{Binding IsBusy}" Content="取消操作" Classes="quiet" Command="{Binding CancelOperationCommand}"/><Button Content="×" Classes="quiet" Command="{Binding CloseSetupCommand}" Padding="0" Width="28" FontSize="20"/></StackPanel></Grid>
  <ScrollViewer IsEnabled="{Binding CanEdit}" Grid.Row="1" Margin="30,24,30,0" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="23"><StackPanel Spacing="12"><TextBlock Text="{Binding SetupProgress}" FontSize="10" LetterSpacing="1.3" Foreground="#A0AEC2"/><TextBlock Text="{Binding SetupTitle}" FontSize="24" FontWeight="SemiBold" LetterSpacing="-.7"/><TextBlock Text="{Binding SetupDescription}" FontSize="12" Foreground="#8A99B0" TextWrapping="Wrap" LineHeight="21"/></StackPanel>
   <StackPanel IsVisible="{Binding SetupInterfaces}" Spacing="18"><Border Classes="card" Padding="18"><StackPanel Spacing="10"><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Fill="{StaticResource Home}" Width="6" Height="6"/><TextBlock Text="家宽网络" FontSize="12" FontWeight="Medium"/></StackPanel><ComboBox ItemsSource="{Binding InterfaceChoices}" SelectedItem="{Binding SelectedHomeInterface,Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:Choice"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel></Border><Border Classes="card" Padding="18"><StackPanel Spacing="10"><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Fill="{StaticResource NonHome}" Width="6" Height="6"/><TextBlock Text="非家宽网络" FontSize="12" FontWeight="Medium"/></StackPanel><ComboBox ItemsSource="{Binding InterfaceChoices}" SelectedItem="{Binding SelectedNonHomeInterface,Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:Choice"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel></Border><TextBlock Text="指定出口失效时连接失败，不允许静默切换网卡。" FontSize="10" Foreground="#A1AFC2"/></StackPanel>
   <StackPanel IsVisible="{Binding SetupSubscription}" Spacing="15"><TextBlock Text="Clash YAML 订阅 URL" FontSize="12" FontWeight="Medium"/><TextBox Text="{Binding SubscriptionUrl,Mode=TwoWay}" FontSize="11"/><Button Name="SetupImportSubscriptionButton" Content="{Binding ImportLabel}" Command="{Binding ImportSubscriptionCommand}" Classes="primary" HorizontalAlignment="Left"/><TextBlock Text="{Binding SetupSubscriptionStatus}" FontSize="10" Foreground="#7F9BB8"/><Border Classes="inset"><TextBlock Text="{Binding SubscriptionDescription}" FontSize="11" Foreground="#96A3B8" TextWrapping="Wrap" LineHeight="20"/></Border><views:LocalSubscriptionView/></StackPanel>
   <StackPanel IsVisible="{Binding SetupGlobal}" Spacing="17"><TextBlock Text="全球默认节点 / 分组" FontSize="12" FontWeight="Medium"/><ComboBox ItemsSource="{Binding GlobalChoices}" SelectedItem="{Binding SelectedGlobalTarget,Mode=TwoWay}" PlaceholderText="请选择一个代理出口"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:Choice"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><StackPanel IsVisible="{Binding SetupGlobalManual}" Spacing="9"><TextBlock Text="手动分组需要明确选择节点" FontSize="11" Foreground="#8A99B0"/><ComboBox ItemsSource="{Binding SetupGlobalMemberChoices}" SelectedItem="{Binding SelectedSetupGlobalMember,Mode=TwoWay}" PlaceholderText="选择该分组的当前节点"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:Choice"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel><Border Background="#EEF4FF" CornerRadius="8" Padding="16"><StackPanel Spacing="12"><TextBlock Text="中国大陆 → 非家宽直连" FontSize="12" Foreground="#6B8AAD"/><TextBlock Text="其他所有流量 → 你选定的代理" FontSize="12" Foreground="#6B8AAD"/><TextBlock Text="代理服务器连接 → 非家宽网卡" FontSize="12" Foreground="#6B8AAD"/></StackPanel></Border></StackPanel>
   <StackPanel IsVisible="{Binding SetupApplications}" Spacing="12"><TextBlock Text="已经管理的应用会继续保留；下面这些仍可添加。" FontSize="11" Foreground="#96A3B8"/><TextBox Name="SetupApplicationSearch" Text="{Binding CatalogQuery,Mode=TwoWay}" PlaceholderText="搜索应用名称、Bundle ID 或路径，例如 Safari…" AutomationProperties.Name="首次设置搜索应用"/><TextBlock IsVisible="{Binding NoCatalogMatch}" Text="没有找到匹配的应用，请更换关键词。" Classes="caption"/><Border Classes="card" Padding="5"><ListBox ItemsSource="{Binding VisibleCatalog}" MaxHeight="230" ItemContainerTheme="{StaticResource QuietRow}"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:CatalogRow"><Grid ColumnDefinitions="26,30,*" ColumnSpacing="10" Margin="8,8"><CheckBox IsEnabled="{Binding CanSelect}" IsChecked="{Binding IsSelected,Mode=TwoWay}"/><ui:ProductAvatar Grid.Column="1" Source="{Binding Icon}" Product="{Binding Product}" Width="28" Height="28"/><TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border><Button Content="{Binding AddSelectedLabel}" Command="{Binding ConfirmAppsCommand}" HorizontalAlignment="Left"/></StackPanel>
   <StackPanel IsVisible="{Binding SetupReview}" Spacing="16"><views:ConnectionAttemptView DataContext="{Binding ConnectionAttempt}"/><Border Background="#F3F6FC" CornerRadius="11" Padding="22"><StackPanel Spacing="12"><ui:Glyph Kind="shield" Width="38" Height="38" Foreground="#7593BD" HorizontalAlignment="Center"/><TextBlock Text="配置已收集，先启动 Xray TUN，再准备规则。" FontSize="14" FontWeight="Medium" HorizontalAlignment="Center"/><TextBlock Text="{Binding SetupApplyDescription}" FontSize="11" Foreground="#7A90AF" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel></Border><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="14"><TextBlock Text="家宽" FontSize="11" Foreground="#95A2B6"/><TextBlock Grid.Column="1" Text="{Binding HomeInterfaceName}" FontSize="12"/><TextBlock Grid.Row="1" Text="全球代理" FontSize="11" Foreground="#95A2B6"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GlobalTargetName}" FontSize="12"/></Grid></StackPanel>
   <Border IsVisible="{Binding HasIssue}" Background="#FFF1F2" CornerRadius="7" Padding="12"><TextBlock Text="{Binding CurrentIssue}" Foreground="#AD6972" FontSize="11" TextWrapping="Wrap"/></Border>
  </StackPanel></ScrollViewer>
  <Border Grid.Row="2" BorderBrush="#E8EDF4" BorderThickness="0,1,0,0" Padding="28,18" Margin="0,25,0,0"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="9"><TextBlock Text="{Binding SetupPermissionText}" FontSize="10" Foreground="#A4AFC0"/><Button Grid.Column="1" Content="上一步" Command="{Binding BackSetupCommand}"/><Button Name="SetupContinueButton" Grid.Column="2" Content="{Binding NextSetupLabel}" Command="{Binding NextSetupCommand}" Classes="primary" MinWidth="90"/></Grid></Border>
 </Grid></Border></Border>
</UserControl>
