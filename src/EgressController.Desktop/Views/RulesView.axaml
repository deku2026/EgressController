<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EgressController.Desktop.ViewModels" xmlns:ui="using:EgressController.Desktop.Presentation.Controls" x:Class="EgressController.Desktop.Views.RulesView" x:DataType="vm:ShellViewModel">
 <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="9"><TextBox Name="RuleSearch" Text="{Binding RuleQuery,Mode=TwoWay}" PlaceholderText="搜索集合或规则内容…" Width="290" HorizontalAlignment="Left"/><Button Grid.Column="1" Content="自定义集合" Command="{Binding ShowCustomRuleCommand}"/><Button Name="AddRulesButton" Grid.Column="2" Content="＋ 添加集合" Classes="primary" Command="{Binding AddRulesCommand}"/></Grid>
  <Border Grid.Row="1" Classes="card" Padding="0"><Grid RowDefinitions="Auto,Auto,*,Auto"><Grid ColumnDefinitions="*,Auto" Margin="18,16"><TextBlock Text="{Binding RuleCountLabel}" Classes="section"/><TextBlock Grid.Column="1" Text="按顺序匹配 · 优先于内置规则" FontSize="10" Foreground="#95A0B2"/></Grid><Border Grid.Row="1" Classes="tableheader"><Grid ColumnDefinitions="*,265,32" ColumnSpacing="12"><TextBlock Text="规则集合" Classes="caption" FontSize="10"/><TextBlock Grid.Column="1" Text="出口策略" Classes="caption" FontSize="10"/></Grid></Border>
   <ListBox Grid.Row="2" Name="ManagedRuleList" ItemsSource="{Binding VisibleRules}" SelectedItem="{Binding SelectedRule,Mode=TwoWay}" ItemContainerTheme="{StaticResource QuietRow}"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:RuleRow"><Grid ColumnDefinitions="38,*,265,28" ColumnSpacing="12" Margin="11,14"><ui:ProductAvatar Product="{Binding Product}" Width="36" Height="36"/><StackPanel Grid.Column="1" Spacing="5"><Grid ColumnDefinitions="*,22,22" ColumnSpacing="2"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"/><Button Grid.Column="1" Content="↑" Classes="quiet" Command="{Binding MoveUpCommand}" Padding="0" MinHeight="20" FontSize="11" ToolTip.Tip="上移规则"/><Button Grid.Column="2" Content="↓" Classes="quiet" Command="{Binding MoveDownCommand}" Padding="0" MinHeight="20" FontSize="11" ToolTip.Tip="下移规则"/></Grid><TextBlock Text="{Binding Subtitle}" Classes="caption" FontSize="10"/></StackPanel><StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center"><ui:RoutePicker SelectedIndex="{Binding RouteIndex,Mode=TwoWay}"/><ComboBox IsVisible="{Binding ProxyVisible}" ItemsSource="{Binding ProxyChoices}" SelectedItem="{Binding SelectedProxyTarget,Mode=TwoWay}" PlaceholderText="选择具体节点或分组" MinHeight="25" Padding="8,3" FontSize="10"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:Choice"><TextBlock Text="{Binding Name}" FontSize="10"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel><Button Grid.Column="3" Content="×" Classes="quiet" Padding="0" Width="26" MinHeight="27" Command="{Binding RemoveCommand}" ToolTip.Tip="移除集合" AutomationProperties.Name="移除集合"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
   <TextBlock Grid.Row="2" IsVisible="{Binding NoRulesMatch}" Text="没有匹配的集合，试试其他名称或规则内容。" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   <StackPanel Grid.Row="2" IsVisible="{Binding RulesEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"><ui:Glyph Kind="rules" Width="42" Height="42" Foreground="#BCC8DC" HorizontalAlignment="Center"/><TextBlock Text="把需要的规则，加成一个集合" FontSize="15" FontWeight="Medium"/><TextBlock Text="搜索服务名称，或创建自己的域名与 IP 规则。" Classes="caption"/><Button Content="浏览规则集合" Classes="primary" Command="{Binding AddRulesCommand}" HorizontalAlignment="Center"/></StackPanel>
   <Border Grid.Row="3" BorderBrush="#ECF0F5" BorderThickness="0,1,0,0" Padding="17,13"><Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="10"><ui:ProductAvatar Product="china" Width="28" Height="28"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="中国大陆" FontSize="11" FontWeight="Medium"/><TextBlock Text="内置域名 + IP · 始终在用户规则之后匹配" FontSize="9.5" Foreground="#94A0B1"/></StackPanel><Border Grid.Column="2" Background="#EFF8F9" CornerRadius="5" Padding="12,7" VerticalAlignment="Center"><TextBlock Text="非家宽直连 · 固定" FontSize="10" Foreground="#398C98"/></Border></Grid></Border>
  </Grid></Border>
  <Border Grid.Row="2" IsVisible="{Binding HasSelectedRule}" Classes="card" Padding="16,12"><StackPanel Spacing="8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding SelectedRuleName}" FontSize="12" FontWeight="Medium"/><TextBlock Grid.Column="1" Text="同一条目保留域名与 IP 两类语义" FontSize="10" Foreground="#93A0B3"/></Grid><TextBlock Text="{Binding SelectedRuleSummary}" FontFamily="Menlo,Consolas" FontSize="10" Foreground="#8A97AB" MaxHeight="95" TextWrapping="Wrap"/></StackPanel></Border>
  <Border Grid.RowSpan="3" IsVisible="{Binding AddingRules}" Background="#F8F9FC"><Grid RowDefinitions="Auto,Auto,*" RowSpacing="17"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="7"><TextBlock Text="找到你需要的规则" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="搜索 Meta 分类索引；添加后统一管理域名和 IP。" Classes="muted"/></StackPanel><Button Grid.Column="1" Content="完成" Command="{Binding CloseRulesCommand}" VerticalAlignment="Top"/></Grid><TextBox Grid.Row="1" Text="{Binding RuleQuery,Mode=TwoWay}" PlaceholderText="搜索 openai、google、youtube…" AutomationProperties.Name="搜索规则目录"/>
   <Border Grid.Row="2" Classes="card" Padding="4"><ListBox ItemsSource="{Binding RuleSuggestions}" ItemContainerTheme="{StaticResource QuietRow}"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:RuleSuggestion"><Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="13" Margin="14,16"><ui:ProductAvatar Product="{Binding Product}" Width="38" Height="38"/><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="13"/><TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#8E9BB0"/></StackPanel><Button Grid.Column="2" Content="{Binding AddLabel}" Command="{Binding AddCommand}" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
  </Grid></Border>
  <Border Grid.RowSpan="3" IsVisible="{Binding CreatingCustomRule}" Background="#F8F9FC"><StackPanel Spacing="20" MaxWidth="650" HorizontalAlignment="Left"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="7"><TextBlock Text="创建自定义集合" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="规则保存在统一配置中，可随时修改出口。" Classes="muted"/></StackPanel><Button Grid.Column="1" Content="取消" Command="{Binding CancelCustomRuleCommand}"/></Grid><Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="集合名称" FontSize="12" FontWeight="Medium"/><TextBox Text="{Binding CustomRuleName,Mode=TwoWay}" PlaceholderText="例如：我的开发服务"/><CheckBox Content="这是 IP / CIDR 集合" IsChecked="{Binding CustomRuleIsIp,Mode=TwoWay}"/><TextBlock Text="每行一条域名后缀或 IP/CIDR，不含协议与端口。" Classes="caption"/><TextBox Text="{Binding CustomRuleEntries,Mode=TwoWay}" PlaceholderText="example.com&#10;api.example.org" AcceptsReturn="True" Height="180" VerticalContentAlignment="Top" FontFamily="Menlo,Consolas"/><Button Content="创建集合" Command="{Binding CreateCustomRuleCommand}" Classes="primary" HorizontalAlignment="Right"/></StackPanel></Border></StackPanel></Border>
 </Grid>
</UserControl>
